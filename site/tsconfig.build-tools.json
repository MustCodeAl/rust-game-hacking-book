{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "scripts/sync-labs.ts",
    "scripts/write-docs-json.ts",
    "scripts/write-reader-editions.ts",
    "scripts/reader-fallbacks.ts",
    "scripts/add-context7-widget.ts",
    "scripts/publish-pages.ts",
    "scripts/prerender-diagrams.ts",
    "env-migration.d.ts",
    "scripts/generate-compat-entries.ts"
  ]
}
