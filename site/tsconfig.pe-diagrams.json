{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/lib/hex-field.ts",
    "src/lib/flow-model.ts",
    "src/lib/pe-address.ts",
    "src/lib/pe-map.ts",
    "src/lib/pe-linking.ts",
    "src/lib/process-model.ts",
    "src/lib/text-encoding.ts",
    "src/lib/text-encoding-view.ts",
    "src/scripts/pe-map.ts",
    "src/scripts/pe-address.ts",
    "src/scripts/process-thread.ts",
    "src/scripts/text-encoding.ts",
    "src/scripts/diagram-player.ts",
    "scripts/check-pe-diagram-models.ts",
    "scripts/check-pe-diagrams-browser.ts"
  ]
}
