{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src/lib/quiz-session.ts",
    "src/scripts/quiz-identity-migration.ts",
    "src/scripts/lesson-quiz.ts",
    "src/lib/flow-model.ts",
    "src/lib/packet-model.ts",
    "src/lib/transport-loss.ts",
    "src/lib/transport-loss-view.ts",
    "src/data/network-flows.ts",
    "src/data/packet-path.ts",
    "src/scripts/diagram-player.ts",
    "src/scripts/predict-reveal.ts",
    "src/scripts/diagram-tabs.ts",
    "src/scripts/detail-picker.ts",
    "src/scripts/packet-path.ts",
    "src/scripts/transport-loss.ts",
    "src/scripts/speech-voices.ts",
    "src/scripts/read-here.ts",
    "src/scripts/live-cells.ts",
    "src/lib/live-labs.ts",
    "src/lib/live-labs-c6.ts",
    "src/data/figures-c6.ts",
    "src/lib/live-labs-c5.ts",
    "src/data/figures-c5.ts",
    "src/lib/live-labs-c4.ts",
    "src/data/figures-c4.ts",
    "src/lib/live-labs-c3.ts",
    "src/data/figures-c3.ts",
    "src/lib/live-labs-c2.ts",
    "src/data/figures-c2.ts",
    "src/lib/live-labs-c1.ts",
    "src/data/figures-c1.ts",
    "src/lib/live-labs-rea.ts",
    "src/data/figures-rea.ts",
    "src/lib/live-model.ts",
    "src/lib/cell-html.ts",
    "src/lib/cell-model.ts"
  ]
}
