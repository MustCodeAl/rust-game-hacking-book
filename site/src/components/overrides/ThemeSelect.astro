---
// Starlight's light/dark/auto picker, plus the book's colour palettes and
// background tones. academy.js wires the selects; an inline head script
// applies the saved choice before first paint.
import Default from '@astrojs/starlight/components/ThemeSelect.astro';

const palettes = [
	['paper', 'Paper'],
	['purple', 'Purple'],
	['midnight', 'Midnight'],
	['forest', 'Forest'],
	['contrast', 'High contrast'],
];
const backgrounds = [
	['theme', 'Palette background'],
	['warm', 'Warm'],
	['cool', 'Cool'],
	['rose', 'Rose'],
	['neutral', 'Neutral'],
];
---

<div class="academy-theme-picker">
	<Default />
	<select data-academy-palette aria-label="Colour palette">
		{palettes.map(([value, label]) => <option value={value}>{label}</option>)}
	</select>
	<select data-academy-background aria-label="Background tone">
		{backgrounds.map(([value, label]) => <option value={value}>{label}</option>)}
	</select>
</div>
