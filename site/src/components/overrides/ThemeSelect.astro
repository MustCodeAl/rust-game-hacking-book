---
import AccountControls from '../AccountControls.astro';
import AudioControls from '../AudioControls.astro';
// The reader-theme panel from the Jekyll edition: page brightness, background
// tone, diagram surfaces, reading layout, code brightness, syntax colours, and
// five reading palettes. academy.js wires the buttons; an inline head script
// applies saved choices before first paint. Starlight renders this component
// in the header and again in the mobile menu, so each copy gets its own id.
const menuId = `academy-theme-menu-${Math.random().toString(36).slice(2, 8)}`;

const backgrounds = [
	['theme', 'Theme'],
	['warm', 'Warm'],
	['cool', 'Cool'],
	['rose', 'Rose'],
	['neutral', 'Neutral'],
];
const syntaxPalettes = [
	['academy', 'Academy'],
	['cyber', 'Cyber'],
	['aurora', 'Aurora'],
	['solar', 'Solar'],
	['ocean', 'Ocean'],
	['mono', 'Mono'],
];
const diagramBackgrounds = [
	['theme', 'Theme'],
	['page', 'Page'],
	['warm', 'Warm'],
	['cool', 'Cool'],
	['rose', 'Rose'],
	['neutral', 'Neutral'],
];
const palettes = [
	['paper', 'Paper', 'Warm field notes'],
	['purple', 'Purple', 'Original dark Academy'],
	['midnight', 'Midnight', 'Blue terminal glow'],
	['forest', 'Forest', 'Low-glare green'],
	['contrast', 'Contrast', 'Black, white, yellow'],
];
---

<div class="academy-reader-tools">
	<!-- The lesson list and "On this page" carry their own Hide buttons, and a
	     tab at the screen edge brings each back, so the header has none. -->
	<button
		class="print-pdf-button print-pdf-button--compact"
		type="button"
		data-print-book
		data-tip="Print this lesson or save it as a PDF"
		aria-label="Print this lesson or save it as a PDF"
	>
		<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
			<path
				fill="currentColor"
				d="M7 3h10v4H7V3Zm-2 6h14a3 3 0 0 1 3 3v5h-4v4H6v-4H2v-5a3 3 0 0 1 3-3Zm3 6v4h8v-4H8Zm10-3.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"
			></path>
		</svg>
	</button>

	<div class="theme-switcher theme-switcher--compact" data-theme-switcher>
		<button class="theme-switcher__toggle" type="button" aria-expanded="false" aria-controls={menuId}>
			<span class="theme-switcher__glyph" aria-hidden="true">◐</span>
			<span class="theme-switcher__toggle-label">Reader theme</span>
			<strong class="theme-switcher__current">
				<span data-theme-label>Paper</span><span aria-hidden="true"> · </span><span data-mode-label>Light</span>
			</strong>
		</button>

		<div class="theme-switcher__menu" id={menuId} hidden>
			<div class="theme-switcher__menu-heading">
				<span aria-hidden="true">🎨</span>
				<span><strong>Appearance</strong><small>Page, diagrams, code, and readability</small></span>
			</div>
			<div class="theme-switcher__section theme-switcher__tierbar">
				<p>How many settings</p>
				<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="How many settings to show">
					<button type="button" data-tier-choice="basic" aria-pressed="false">Basic</button>
					<button type="button" data-tier-choice="advanced" aria-pressed="false">Advanced</button>
					<button type="button" data-tier-choice="detailed" aria-pressed="false">Detailed</button>
				</div>
				<small class="theme-switcher__help" data-tier-help="basic">Brightness, reading palette, text size and reading sound.</small>
				<small class="theme-switcher__help" data-tier-help="advanced">Adds page background, hover cards, button corners, code colours, width and layout.</small>
				<small class="theme-switcher__help" data-tier-help="detailed">Everything, including diagram styling, motion, inline code, depth and fine details.</small>
			</div>
			<div class="theme-switcher__tier" data-tier="basic">
				<AudioControls />
			<div class="theme-switcher__section">
				<p>Page brightness</p>
				<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Reader brightness">
					<button type="button" data-mode-choice="light" aria-pressed="false"><span aria-hidden="true">☀️</span> Light</button>
					<button type="button" data-mode-choice="dark" aria-pressed="false"><span aria-hidden="true">🌙</span> Dark</button>
					<button type="button" data-mode-choice="auto" aria-pressed="false"><span aria-hidden="true">💻</span> Auto</button>
				</div>
			</div>
			<div class="theme-switcher__section">
				<p>Lesson text size</p>
				<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Lesson text size">
					<button type="button" data-text-size-choice="small" aria-pressed="false">Small</button>
					<button type="button" data-text-size-choice="standard" aria-pressed="false">Default</button>
					<button type="button" data-text-size-choice="large" aria-pressed="false">Large</button>
				</div>
			</div>
			<div class="theme-switcher__section">
				<p>Reading palette</p>
				<div class="theme-switcher__choices" role="group" aria-label="Reader themes">
					{
						palettes.map(([id, label, description]) => (
							<button type="button" data-theme-choice={id} aria-pressed="false">
								<span class={`theme-swatch theme-swatch--${id}`} aria-hidden="true" />
								<span>
									<strong>{label}</strong>
									<small>{description}</small>
								</span>
							</button>
						))
					}
				</div>
			</div>
			</div>
			<div class="theme-switcher__tier" data-tier="advanced">
				<p class="theme-switcher__tier-title">More options</p>
				<AccountControls />
			<div class="theme-switcher__section">
				<p>Page background</p>
				<div class="theme-switcher__backgrounds" role="group" aria-label="Page background colour">
					{
						backgrounds.map(([id, label]) => (
							<button type="button" data-background-choice={id} aria-pressed="false">
								<span class={`background-dot background-dot--${id}`} aria-hidden="true" />
								{label}
							</button>
						))
					}
				</div>
			</div>
			<div class="theme-switcher__section">
				<p>Hover cards</p>
				<div class="theme-switcher__modes" role="group" aria-label="Hover cards">
					<button type="button" data-cards-choice="on" aria-pressed="false">On</button>
					<button type="button" data-cards-choice="off" aria-pressed="false">Off</button>
				</div>
				<small class="theme-switcher__help">Definitions, examples, tips, and lesson summaries that open over words and links. Off also removes the underlines.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Chat button</p>
				<div class="theme-switcher__modes theme-switcher__modes--chat" role="group" aria-label="Chat button position">
					<button type="button" data-chat-choice="top-left" aria-pressed="false"><span aria-hidden="true">↖</span> Top left</button>
					<button type="button" data-chat-choice="top-right" aria-pressed="false"><span aria-hidden="true">↗</span> Top right</button>
					<button type="button" data-chat-choice="bottom-left" aria-pressed="false"><span aria-hidden="true">↙</span> Bottom left</button>
					<button type="button" data-chat-choice="bottom-right" aria-pressed="false"><span aria-hidden="true">↘</span> Bottom right</button>
					<button type="button" data-chat-choice="off" aria-pressed="false">Off</button>
				</div>
				<small class="theme-switcher__help">Which corner the button for asking questions about the book sits in. Top corners stop short of the lesson list and contents; at the bottom right it sits under the Notes button. It takes the colour of the chapter you are reading.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Notes button</p>
				<div class="theme-switcher__modes theme-switcher__modes--chat" role="group" aria-label="Notes button position">
					<button type="button" data-notes-choice="tl" aria-pressed="false"><span aria-hidden="true">↖</span> Top left</button>
					<button type="button" data-notes-choice="tr" aria-pressed="false"><span aria-hidden="true">↗</span> Top right</button>
					<button type="button" data-notes-choice="bl" aria-pressed="false"><span aria-hidden="true">↙</span> Bottom left</button>
					<button type="button" data-notes-choice="br" aria-pressed="false"><span aria-hidden="true">↘</span> Bottom right</button>
					<button type="button" data-notes-choice="hidden" aria-pressed="false">Hidden</button>
				</div>
				<small class="theme-switcher__help">Where the 📝 Notes button sits on lessons. Hidden leaves a thin tab on the edge; Alt + N brings it back.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Settings panel</p>
				<div class="theme-switcher__modes" role="group" aria-label="Settings panel">
					<button type="button" data-drawer-choice="popover" aria-pressed="false">Popover</button>
					<button type="button" data-drawer-choice="sheet" aria-pressed="false">Side sheet</button>
				</div>
				<small class="theme-switcher__help">Popover opens under the button. Side sheet slides in from the right with a dimmed page behind it.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Sidebar and header contrast</p>
				<div class="theme-switcher__modes" role="group" aria-label="Sidebar and header contrast">
					<button type="button" data-surface-choice="default" aria-pressed="false">Original</button>
					<button type="button" data-surface-choice="unified" aria-pressed="false">Unified</button>
				</div>
				<small class="theme-switcher__help">Original keeps the dark lesson list and header. Unified tints them to match the page and palette.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Reading width</p>
				<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Reading width">
					<button type="button" data-measure-choice="narrow" aria-pressed="false">Narrow</button>
					<button type="button" data-measure-choice="standard" aria-pressed="false">Standard</button>
					<button type="button" data-measure-choice="wide" aria-pressed="false">Wide</button>
				</div>
				<small class="theme-switcher__help">How wide the lesson text column is. Standard is about 70 characters a line.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Table of contents</p>
				<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Table of contents">
					<button type="button" data-toc-tone-choice="page" aria-pressed="false">Match page</button>
					<button type="button" data-toc-tone-choice="light" aria-pressed="false">Light</button>
					<button type="button" data-toc-tone-choice="dark" aria-pressed="false">Dark</button>
				</div>
				<small class="theme-switcher__help">Light or dark for the “On this page” panel on the right, whatever the page is.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Lesson spacing</p>
				<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Lesson spacing">
					<button type="button" data-spacing-choice="compact" aria-pressed="false">Compact</button>
					<button type="button" data-spacing-choice="comfortable" aria-pressed="false">Default</button>
					<button type="button" data-spacing-choice="spacious" aria-pressed="false">Spacious</button>
				</div>
			</div>
			<div class="theme-switcher__section">
				<p>Code brightness</p>
				<div class="theme-switcher__modes theme-switcher__modes--code" role="group" aria-label="Code-block brightness">
					<button type="button" data-code-mode-choice="page" aria-pressed="false"><span aria-hidden="true">🔗</span> Match page</button>
					<button type="button" data-code-mode-choice="dark" aria-pressed="false"><span aria-hidden="true">⌨️</span> Dark</button>
					<button type="button" data-code-mode-choice="light" aria-pressed="false"><span aria-hidden="true">📄</span> Light</button>
				</div>
			</div>
			<div class="theme-switcher__section">
				<p>Syntax colours</p>
				<div class="theme-switcher__modes theme-switcher__modes--palette" role="group" aria-label="Syntax colour palette">
					{
						syntaxPalettes.map(([id, label]) => (
							<button type="button" data-syntax-palette-choice={id} aria-pressed="false">
								{label}
							</button>
						))
					}
				</div>
			</div>
				<div class="theme-switcher__section">
					<p>Moving effects</p>
					<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Animation motion">
						<button type="button" data-motion-choice="system" aria-pressed="false">System</button>
						<button type="button" data-motion-choice="onrequest" aria-pressed="false">On Play</button>
						<button type="button" data-motion-choice="off" aria-pressed="false">Off</button>
					</div>
					<small class="theme-switcher__help">System respects reduced motion while still advancing steps. On Play enables moving effects when you start a diagram. Off keeps manual steps.</small>
				</div>
			</div>
			<div class="theme-switcher__tier" data-tier="detailed">
				<p class="theme-switcher__tier-title">Fine-tuning</p>
			<div class="theme-switcher__section">
				<p>Depth</p>
				<div class="theme-switcher__modes" role="group" aria-label="Depth">
					<button type="button" data-depth-choice="flat" aria-pressed="false">Flat</button>
					<button type="button" data-depth-choice="soft" aria-pressed="false">Soft</button>
				</div>
				<small class="theme-switcher__help">Flat is the original. Soft adds faint shadows to diagram boxes, cards and buttons and lifts them slightly on hover.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Inline code</p>
				<div class="theme-switcher__modes" role="group" aria-label="Inline code">
					<button type="button" data-inline-code-choice="classic" aria-pressed="false">Classic</button>
					<button type="button" data-inline-code-choice="soft" aria-pressed="false">Soft</button>
				</div>
				<small class="theme-switcher__help">Classic keeps the badge look. Soft quiets the background and border for paragraphs full of keywords.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Floating buttons</p>
				<div class="theme-switcher__modes" role="group" aria-label="Floating buttons">
					<button type="button" data-floating-choice="docked" aria-pressed="false">Docked</button>
					<button type="button" data-floating-choice="minimal" aria-pressed="false">Minimal</button>
				</div>
				<small class="theme-switcher__help">Docked shows the Notes and chat buttons normally. Minimal makes them small icons that fade until you point at them.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Gradients</p>
				<div class="theme-switcher__modes" role="group" aria-label="Page gradients">
					<button type="button" data-gradients-choice="on" aria-pressed="false">On</button>
					<button type="button" data-gradients-choice="off" aria-pressed="false">Off</button>
				</div>
				<small class="theme-switcher__help">Use flat colours for headings, cards and diagram backgrounds.</small>
			</div>
			<div class="theme-switcher__section">
				<p>Diagram background</p>
				<div class="theme-switcher__backgrounds theme-switcher__backgrounds--diagram" role="group" aria-label="Diagram background colour">
					{diagramBackgrounds.map(([id, label]) => (
						<button type="button" data-diagram-background-choice={id} aria-pressed="false">
							<span class={`background-dot background-dot--${id}`} aria-hidden="true" />
							{label}
						</button>
					))}
				</div>
				<small class="theme-switcher__help">Changes diagram surfaces; labels and role colours remain readable.</small>
			</div>
			<div class="theme-switcher__section theme-switcher__section--toggles">
				<div>
					<p>Diagram boxes</p>
					<div class="theme-switcher__modes" role="group" aria-label="Diagram box fills">
						<button type="button" data-diagram-fill-choice="tinted" aria-pressed="false">Tinted</button>
						<button type="button" data-diagram-fill-choice="plain" aria-pressed="false">Plain</button>
					</div>
				</div>
				<div>
					<p>Heading rectangles</p>
					<div class="theme-switcher__modes" role="group" aria-label="Heading rectangles">
						<button type="button" data-heading-style-choice="boxed" aria-pressed="false">On</button>
						<button type="button" data-heading-style-choice="plain" aria-pressed="false">Off</button>
					</div>
				</div>
			</div>
			<div class="theme-switcher__section">
				<p>Diagram label backgrounds</p>
				<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Diagram label backgrounds">
					<button type="button" data-diagram-labels-choice="soft" aria-pressed="false">Soft</button>
					<button type="button" data-diagram-labels-choice="outlined" aria-pressed="false">Outlined</button>
					<button type="button" data-diagram-labels-choice="none" aria-pressed="false">None</button>
				</div>
			</div>
			<div class="theme-switcher__section">
				<p>Diagram frames</p>
				<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Diagram frame strength">
					<button type="button" data-diagram-borders-choice="soft" aria-pressed="false">Soft</button>
					<button type="button" data-diagram-borders-choice="strong" aria-pressed="false">Strong</button>
					<button type="button" data-diagram-borders-choice="none" aria-pressed="false">None</button>
				</div>
			</div>
			<div class="theme-switcher__section theme-switcher__section--toggles">
				<div>
					<p>Diagram size</p>
					<div class="theme-switcher__modes" role="group" aria-label="Diagram size">
						<button type="button" data-diagram-size-choice="fit" aria-pressed="false">Fit page</button>
						<button type="button" data-diagram-size-choice="actual" aria-pressed="false">Full size</button>
					</div>
				</div>
				<div>
					<p>Page grid</p>
					<div class="theme-switcher__modes" role="group" aria-label="Page grid">
						<button type="button" data-grid-choice="on" aria-pressed="false">On</button>
						<button type="button" data-grid-choice="off" aria-pressed="false">Off</button>
					</div>
				</div>
			</div>
				<div class="theme-switcher__section">
					<p>Time per step</p>
					<div class="theme-switcher__modes theme-switcher__modes--three" role="group" aria-label="Animation playback speed">
						<button type="button" data-animation-speed-choice="slow" aria-pressed="false">6 seconds</button>
						<button type="button" data-animation-speed-choice="normal" aria-pressed="false">4 seconds</button>
						<button type="button" data-animation-speed-choice="fast" aria-pressed="false">2 seconds</button>
					</div>
				</div>
			<div class="theme-switcher__section theme-switcher__section--toggles">
				<div>
					<p>Semantic colours</p>
					<div class="theme-switcher__modes" role="group" aria-label="Semantic highlighting">
						<button type="button" data-semantic-choice="on" aria-pressed="false"><span aria-hidden="true">🧠</span> On</button>
						<button type="button" data-semantic-choice="off" aria-pressed="false">Off</button>
					</div>
				</div>
				<div>
					<p>Ligatures</p>
					<div class="theme-switcher__modes" role="group" aria-label="Programming ligatures">
						<button type="button" data-ligature-choice="on" aria-pressed="false"><span aria-hidden="true">=&gt;</span> On</button>
						<button type="button" data-ligature-choice="off" aria-pressed="false">Off</button>
					</div>
				</div>
			</div>
			<details class="theme-switcher__colour-key">
				<summary>What the colours mean</summary>
				<ul>
					<li data-reading-role="information"><span class="theme-switcher__role-swatch" aria-hidden="true" />Terms, inputs, and data</li>
					<li data-reading-role="process"><span class="theme-switcher__role-swatch" aria-hidden="true" />Code and processing</li>
					<li data-reading-role="result"><span class="theme-switcher__role-swatch" aria-hidden="true" />Results and tips</li>
					<li data-reading-role="caution"><span class="theme-switcher__role-swatch" aria-hidden="true" />Cautions</li>
				</ul>
				<p>These colours follow your theme; their meanings stay the same. Data tables and diagram explanations use the information colour; code panels use processing. The lesson header and navigation identify its chapter. Correct answers are green; errors are red.</p>
			</details>
			</div>
			<button class="theme-switcher__reset" type="button" data-theme-reset>Reset appearance</button>
			<small class="theme-switcher__shortcut">Alt + T palette · Alt + D page · Alt + C code · Alt + S syntax · Alt + H semantic · Alt + L ligatures · Alt + N lesson list · Alt + O on this page</small>
		</div>
	</div>
</div>
