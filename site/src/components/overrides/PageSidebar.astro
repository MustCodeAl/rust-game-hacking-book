---
// "On this page", with its Hide button on the panel itself, in a bar above the
// list. While the panel is hidden, academy.js shows an "On this page" tab at
// the right edge that brings it back. Below 72rem Starlight turns the panel
// into a bar under the header, and reader.css floats this button over that
// bar's right end.
import Default from '@astrojs/starlight/components/PageSidebar.astro';
---

{
	Astro.locals.starlightRoute.toc && (
		<div class="panel-bar panel-bar--toc">
			<button type="button" class="panel-hide panel-hide--toc" data-panel-hide="toc" data-tip="Hide “On this page” · Alt+O">
				<span>
					Hide<span class="sr-only"> “On this page”</span>
				</span>
				<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
					<path d="m9.5 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</button>
		</div>
	)
}
<Default />
