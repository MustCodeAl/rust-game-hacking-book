---
// The lesson list, with its Hide button on the list itself rather than in the
// header, so the control sits on the panel it hides. While the list is hidden,
// academy.js shows a "Lessons" tab at the left edge that brings it back. On
// phones the list lives in the menu, which closes itself, so the bar is only
// shown on wider screens.
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<div class="panel-bar panel-bar--sidebar">
	<span class="panel-bar__title">Lesson list</span>
	<button
		type="button"
		class="panel-hide panel-hide--sidebar"
		data-panel-hide="sidebar"
		aria-controls="starlight__sidebar"
		data-tip="Hide the lesson list · Alt+B"
	>
		<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
			<path d="M14.5 6 8.5 12l6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
		<span>Hide<span class="sr-only"> the lesson list</span></span>
	</button>
</div>
<Default />
