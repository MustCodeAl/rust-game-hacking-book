---
// Every lesson ends with its knowledge check from lesson-quizzes.json, so the
// quiz stays in one data file instead of being pasted into every lesson, and
// then with the card that marks the lesson (or its chapter) done.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import LessonFinish from '../LessonFinish.astro';
import Notes from '../Notes.astro';
import ResumeReading from '../ResumeReading.astro';
import Cheatsheet from '../Cheatsheet.astro';
import { buildCheatsheet } from '../../lib/cheatsheet.mjs';
import banks from '../../data/lesson-quiz-banks.json';
import Quiz from '../Quiz.astro';
import quizzes from '../../data/lesson-quizzes.json';

type LessonQuiz = { id: string; title: string; prompt: string; options: string; answer: string | number; explanation: string };
const entry = Astro.locals.starlightRoute.entry;
const chapter = entry.data.chapter;
const quiz = chapter ? (quizzes as Record<string, LessonQuiz>)[chapter] : undefined;
const cheat =
	chapter && quiz
		? buildCheatsheet({
				body: entry.body,
				title: entry.data.title,
				lesson: chapter,
				seed: { ...quiz, options: quiz.options.split('||'), answer: String(quiz.answer) },
				bank: (banks as Record<string, { questions: any[] }>)[chapter]?.questions,
			})
		: undefined;
---

<Default>
	{chapter && cheat && <Cheatsheet lesson={chapter} title={entry.data.title} markdown={cheat} />}
	<slot />
	{
		quiz && (
			<Quiz
				id={quiz.id}
				title={quiz.title}
				prompt={quiz.prompt}
				options={quiz.options}
				answer={String(quiz.answer)}
				explanation={quiz.explanation}
				chapter={chapter}
			/>
		)
	}
	{chapter && <LessonFinish id={entry.id} lesson={chapter} />}
	{chapter && <Notes id={entry.id} lesson={chapter} title={entry.data.title} />}
	{chapter && <ResumeReading id={entry.id} lesson={chapter} title={entry.data.title} />}
</Default>
