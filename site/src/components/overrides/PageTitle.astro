---
// Lesson pages get the book's header: chapter kicker, title, summary, study
// time, and the button that marks the lesson done. Pages that draw their own
// heading (hideTitle) keep only the `_top` anchor Starlight's table of contents
// links to. The header wears its chapter's colour (data-tone), as the
// chapter's sidebar number and home card do.
import { chapterOf, chapterTone } from '../../data/chapters.ts';
import DoneToggle from '../DoneToggle.astro';
import ReadHere from '../ReadHere.astro';

const entry = Astro.locals.starlightRoute.entry;
const { title, description, chapter, minutes, hideTitle } = entry.data;
const info = chapter ? chapterOf(chapter) : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const readerUrl = `${base}/read/${entry.id.replace(/^pages\//, '')}/`;
---

{
	hideTitle ? (
		<span id="_top" />
	) : info ? (
		<header class="lesson-header" data-tone={chapterTone(info.number)}>
			<div class="lesson-kicker">
				<span>
					<span aria-hidden="true">{info.emoji}</span> Lesson {chapter}
				</span>
				<span>{info.title}</span>
			</div>
			<h1 id="_top">{title}</h1>
			{description && <p class="lesson-summary">{description}</p>}
			<div class="lesson-actionbar" role="group" aria-label="Lesson actions">
				<span class="lesson-actionbar__chapter">Lesson {chapter}</span>
			<div class="lesson-reading-actions">
				<ReadHere readerUrl={readerUrl} title={title} />
				<a href={readerUrl} data-tip="A plain article of this lesson for reading aloud, text-to-speech, or a reading app">
					Read or listen
				</a>
				<a href={`${base}/print/#chapter-${info.number}`} data-tip="Print or save this chapter, or the whole book, as a PDF">
					Print chapter or book
				</a>
			</div>
			<div class="lesson-meta">
				{
					minutes && (
						<div class="lesson-stats" role="group" aria-label="Lesson details">
							<span>About {minutes} minutes</span>
						</div>
					)
				}
				<DoneToggle id={entry.id} lesson={chapter!} />
			</div>
			</div>
		</header>
	) : (
		<h1 id="_top" class="plain-title">{title}</h1>
	)
}

<style>
	.lesson-reading-actions { display: flex; flex-wrap: wrap; gap: 0.65rem 1.25rem; margin-top: 0.8rem; font-size: 0.82rem; }
	.lesson-reading-actions a { color: var(--chapter-ink); text-underline-offset: 0.2em; }
	.plain-title {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}
</style>
