---
// Starlight's own <head>, preceded by preloads for the two fonts every page
// uses. Fetching them before the first layout means the page is laid out once
// in its final fonts instead of once in a fallback and again when they land.
import Default from '@astrojs/starlight/components/Head.astro';
import bodyFont from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import displayFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
---

<link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
<Default />
