---
// Starlight's footer (edit link and pagination) followed by the book's credit:
// where the book came from, and the licence it is published under. The credit
// is the same on every page, so search does not index it.
import Default from '@astrojs/starlight/components/Footer.astro';
import Mark from '../identity/Mark.astro';

const ORIGINAL_SITE = 'https://gamehacking.academy';
const ORIGINAL_SOURCE = 'https://github.com/GameHackingAcademy/gamehackingacademy.github.io';
const THIS_SOURCE = 'https://github.com/MustCodeAl/rust-game-hacking-book';
const LICENCE = `${THIS_SOURCE}/blob/codex/book-revision/LICENSE`;
---

<Default />

<div class="gha-credit" data-pagefind-ignore>
	<Mark class="gha-credit__mark" />
	<p>
		This book grew out of the original <a href={ORIGINAL_SITE}>Game Hacking Academy</a> by attilathedud and has
		been rewritten as a beginner-first course.
		Like the <a href={ORIGINAL_SOURCE}>original repository</a>, its <a href={THIS_SOURCE}>source</a> is published
		under the <a href={LICENCE}>Apache License 2.0</a>.
	</p>
</div>
