---
// Static data, a stack frame and a heap block have three different lifetimes. Five steps tell one story. Each step is
// one colour-coded frame with the three places side by side; the shared stepper (CellFrames) plays them in order.
import { ITEMS, lifeOf, lifetimeSteps } from '../lib/storage-lifetimes';
import { cell, frame, hot, panel, row, type CellFrame, type CellScenario } from '../lib/cell-model';
import type { Hue } from '../lib/diagram-visual';
import CellFrames from './CellFrames.astro';
interface Props { id?: string; title?: string }
const { id = 'storage-lifetimes', title = 'Three places, three lifetimes' } = Astro.props;
const places: readonly { place: 'static' | 'stack' | 'heap'; title: string; lasts: string; hue: Hue }[] = [
  { place: 'static', title: 'Module data', lasts: 'lasts as long as the program', hue: 'blue' },
  { place: 'stack', title: 'Thread stack', lasts: 'lasts as long as each call', hue: 'purple' },
  { place: 'heap', title: 'Heap', lasts: 'lasts until its owner frees it', hue: 'green' },
];
const steps = lifetimeSteps();
const frames: CellFrame[] = steps.map((step, index) => {
  const before = index > 0 ? steps[index - 1] : undefined;
  return frame(step.title, step.caption, places.map(place => panel(`${place.title}: ${place.lasts}`, place.hue, [
    ...ITEMS.filter(item => item.place === place.place).map(item => {
      const life = lifeOf(step, item.id);
      const value = step.values[item.id] ?? '';
      const changed = before !== undefined && (lifeOf(before, item.id) !== life || before.values[item.id] !== value);
      const dangling = value.includes('dangling');
      const pointerNote = item.id === 'block' && life === 'live' ? (index === 2 ? 'p points here' : index === 3 ? 'unit points here' : undefined) : undefined;
      const options = { sub: life === 'live' ? 'live' : life === 'absent' ? 'not created yet' : 'released' };
      const shown = life === 'live'
        ? (changed || dangling ? hot : cell)(value, dangling ? 'red' : place.hue, 1, options)
        : cell(value, life === 'released' ? 'red' : 'gray', 1, { ...options, ghost: true });
      return row(item.name, [shown], pointerNote ? { link: pointerNote } : {});
    }),
  ])), { side: true });
});
const scenario: CellScenario = {
  id: 'story', tab: 'One call',
  title,
  summary: 'A pointer inside a stack frame can refer to a heap block with a different lifetime. Step through one call to watch each place start and end on its own. Positions are schematic.',
  frames,
};
---
<CellFrames id={id} title={title} scenarios={[scenario]} />
