---
// The book's mark: three joined byte boxes holding 47 48 41, the ASCII codes
// of G, H and A (71 = 4 × 16 + 7 = 0x47, 72 = 0x48, 65 = 4 × 16 + 1 = 0x41).
// The notch above the first box is a pointer to the first byte, and the first
// box is tinted the way lesson figures mark the byte under discussion.
// Colours come from theme tokens (see identity.css), so the mark follows every
// palette and prints in ink. It sits beside the written title wherever it is
// used, so it is hidden from assistive technology.
import { NAME_BYTES } from './bytes';

interface Props {
	class?: string;
}
const { class: className } = Astro.props;
const centres = [12, 34, 56];
---

<svg class:list={['gha-mark', className]} viewBox="0 0 68 30" aria-hidden="true" focusable="false">
	<path class="gha-mark__notch" d="M8 0h8l-4 4.6z" />
	<path class="gha-mark__hit" d="M5 7H23V29H5A4 4 0 0 1 1 25V11A4 4 0 0 1 5 7Z" />
	<rect class="gha-mark__frame" x="1" y="7" width="66" height="22" rx="4" />
	<path class="gha-mark__frame" d="M23 7v22M45 7v22" />
	{NAME_BYTES.map((byte, index) => (
		<text class="gha-mark__byte" x={centres[index]} y="22.2" text-anchor="middle">{byte}</text>
	))}
</svg>
