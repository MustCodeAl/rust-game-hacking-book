---
// The 404 page. A debugger prints ?? for bytes it cannot read, such as an
// address where no memory is mapped; a missing page is the site's version of
// that, so the page shows the same four boxes as the home page's readable ones,
// unreadable, the address that was asked for, and the ways back. The two small
// scripts run as the page is read, before it is drawn, so nothing moves when
// the address and the search button appear.
import MemoryStrip from '../MemoryStrip.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cells = Array.from({ length: 4 }, () => '=??').join('|');
---

<section class="gha-lost not-content" aria-labelledby="gha-lost-title">
	<h1 id="gha-lost-title" class="gha-lost__title">No page is stored at this address.</h1>
	<p class="gha-lost__path" data-gha-path hidden></p>
	<script is:inline>(function () { var line = document.querySelector('[data-gha-path]'); if (!line) return; var shown = location.pathname; try { shown = decodeURIComponent(shown); } catch (e) {} var code = document.createElement('code'); code.textContent = shown; line.appendChild(code); line.hidden = false; })();</script>
	<MemoryStrip cells={cells} label="Four unreadable bytes, shown as question marks" />
	<p class="gha-lost__text">
		A debugger shows <code>??</code> for bytes it cannot read, such as an address where no memory is mapped. This site
		has nothing stored at the address you asked for. The link may be out of date, or the address may have a typing
		mistake.
	</p>
	<div class="gha-lost__actions">
		<button type="button" class="button button--primary" data-gha-search hidden>Search the book</button>
		<script is:inline>(function () { var search = document.querySelector('[data-gha-search]'); var open = document.querySelector('site-search button[data-open-modal]'); if (!search || !open) return; search.hidden = false; search.addEventListener('click', function () { open.click(); }); })();</script>
		<a class="button button--ghost" href={`${base}/contents/`}>See all lessons</a>
		<a class="gha-hero__link" href={`${base}/`}>Go to the book’s home page</a>
	</div>
</section>
