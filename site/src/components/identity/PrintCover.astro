---
// The printed book's title page, shown only in print. Below the mark and the
// title, the title itself is listed as `hexdump -C` would print it: the offset
// of each row, sixteen bytes in two groups of eight, and the characters they
// encode. "Game Hacking Academy" is 20 bytes, so the second row holds 4.
import { getCollection } from 'astro:content';
import { CHAPTERS } from '../../data/chapters.ts';
import Mark from './Mark.astro';
import { TITLE, hexdumpRows } from './bytes';
import '../../styles/identity.css';

interface Props {
	/** A chapter number when the page prints a single chapter. */
	chapter?: number;
}
const { chapter } = Astro.props;
const lessons = await getCollection('docs', (entry) => Boolean(entry.data.chapter));
const chapterInfo = chapter ? CHAPTERS.find((item) => item.number === chapter) : undefined;
const chapterLessons = chapter ? lessons.filter((entry) => entry.data.chapter!.startsWith(`${chapter}.`)).length : 0;
const chapterCount = new Set(lessons.map((entry) => entry.data.chapter!.split('.')[0])).size;
const rows = hexdumpRows(TITLE);
const built = new Date().toISOString().slice(0, 10);
const site = `${import.meta.env.SITE.replace(/^https?:\/\//, '')}${import.meta.env.BASE_URL}`.replace(/\/$/, '');
---

<section class="gha-cover print-only" aria-label="Title page">
	<Mark class="gha-cover__mark" />
	<p class="gha-cover__title">{TITLE}</p>
	<p class="gha-cover__subtitle">
		{chapterInfo ? `Chapter ${chapterInfo.number}: ${chapterInfo.title}` : 'How games work, down to the bytes'}
	</p>
	<pre class="gha-cover__dump" aria-hidden="true">{rows.map((row) => {
		const groups = [row.bytes.slice(0, 8), row.bytes.slice(8, 16)].map((group) => group.join(' ').padEnd(23, ' '));
		return `${row.offset}  ${groups.join('  ')}  |${row.text}|\n`;
	}).join('')}</pre>
	<p class="gha-cover__note">The title as it sits in memory: one byte per letter, written in hexadecimal.</p>
	<p class="gha-cover__facts">
		{chapterInfo ? `${chapterLessons} lessons from a book of ${lessons.length}` : `${lessons.length} lessons in ${chapterCount} chapters`}.
		Printed from {site}, built {built}.
	</p>
	<p class="gha-cover__credit">
		Grew out of the original Game Hacking Academy by attilathedud (gamehacking.academy). Published under the Apache
		License 2.0.
	</p>
</section>
