---
// A reader's own notes for one lesson, written in Markdown and kept in this
// browser (and in their account when sign-in is configured). Behaviour is in
// src/scripts/notes.js: autosave, a safe preview, and export to a .md file
// that opens in massCode or any notes app.
interface Props {
	/** The lesson's URL id, such as "pages/1/10". */
	id: string;
	/** The displayed lesson number, such as "2.2". */
	lesson: string;
	title: string;
}
const { id, lesson, title } = Astro.props;
---

<section class="lesson-notes not-content print:hidden" data-lesson-notes data-note-id={id} data-note-lesson={lesson} data-note-title={title} data-reader-skip>
	<details>
		<summary>My notes for Lesson {lesson} <span data-note-summary></span></summary>
		<div class="lesson-notes__tabs" role="tablist" aria-label="Note view">
			<button type="button" role="tab" aria-selected="true" data-note-tab="write">Write</button>
			<button type="button" role="tab" aria-selected="false" data-note-tab="preview">Preview</button>
		</div>
		<textarea
			data-note-text
			rows="8"
			maxlength="50000"
			aria-label={`Notes for Lesson ${lesson}, in Markdown`}
			placeholder="Write notes in Markdown: # headings, **bold**, `code`, - lists, - [ ] tasks, > quotes."
			spellcheck="true"></textarea>
		<div class="lesson-notes__preview" data-note-preview hidden></div>
		<div class="lesson-notes__actions">
			<button type="button" data-note-export>Export this note (.md)</button>
			<button type="button" data-note-export-all>Export all notes (.md)</button>
			<button type="button" data-note-clear>Clear this note</button>
		</div>
		<p class="lesson-notes__status" data-note-status role="status" aria-live="polite">Notes are plain Markdown, saved automatically in this browser.</p>
	</details>
</section>

<script>
	import { mountNotes } from '../scripts/notes.js';
	mountNotes();
</script>

<style is:global>
	.lesson-notes { margin-block: 1.2rem; padding: 0.7rem 1rem; border: 1px solid var(--reader-line, var(--line)); border-radius: 12px; background: var(--reader-panel, var(--surface-alt)); }
	.lesson-notes > details > summary { cursor: pointer; font-weight: 650; color: var(--ink-strong); }
	.lesson-notes [data-note-summary] { margin-left: 0.4rem; font-weight: 400; font-size: 0.85em; color: var(--ink-soft); }
	.lesson-notes__tabs { display: flex; gap: 6px; margin: 0.6rem 0 0.4rem; }
	.lesson-notes__tabs button, .lesson-notes__actions button { padding: 0.25rem 0.7rem; color: var(--ink); font: inherit; font-size: 0.85em; background: var(--surface-alt, transparent); border: 1px solid var(--line); border-radius: 6px; cursor: pointer; }
	.lesson-notes__tabs button[aria-selected='true'] { color: var(--chapter-ink, var(--ink-strong)); border-color: var(--chapter-accent); background: var(--chapter-tint, transparent); font-weight: 650; }
	.lesson-notes textarea { box-sizing: border-box; width: 100%; min-height: 9rem; padding: 0.6rem; color: var(--ink); font: 0.9rem/1.5 var(--mono); border: 1px solid var(--line); border-radius: 8px; background: var(--surface-alt, transparent); resize: vertical; }
	.lesson-notes__preview { min-height: 9rem; padding: 0.4rem 0.8rem; overflow-wrap: anywhere; border: 1px dashed var(--line); border-radius: 8px; }
	.lesson-notes__preview[hidden], .lesson-notes textarea[hidden] { display: none; }
	.lesson-notes__preview pre { overflow: auto; padding: 0.6rem; border: 1px solid var(--line); border-radius: 6px; font-family: var(--mono); font-size: 0.85em; }
	.lesson-notes__preview code { font-family: var(--mono); font-size: 0.9em; }
	.lesson-notes__preview blockquote { margin: 0.5rem 0; padding-left: 0.8rem; border-left: 3px solid var(--chapter-accent); color: var(--ink-soft); }
	.lesson-notes__actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 0.5rem; }
	.lesson-notes__status { margin: 0.4rem 0 0; color: var(--ink-soft); font-size: 0.8em; }
</style>
