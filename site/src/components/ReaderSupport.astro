---
import '../styles/reader-support.css';
---
<div class="reader-support not-content" data-reader-support data-reader-skip>
  <button type="button" class="reader-shortcuts" data-reader-hud-open aria-label="Keyboard shortcuts" aria-haspopup="dialog" aria-controls="reader-keyboard-help" hidden>?</button>
  <dialog class="reader-keyboard-hud" id="reader-keyboard-help" data-reader-hud aria-labelledby="reader-keyboard-title">
    <header><h2 id="reader-keyboard-title">Keyboard shortcuts</h2><button type="button" data-reader-hud-close aria-label="Close keyboard shortcuts">×</button></header>
    <dl>
      <div><dt><kbd>?</kbd></dt><dd>Open this guide</dd></div>
      <div><dt><kbd>Alt</kbd> + <kbd>B</kbd></dt><dd>Show or hide the lesson list</dd></div>
      <div><dt><kbd>Alt</kbd> + <kbd>O</kbd></dt><dd>Show or fold the lesson outline</dd></div>
      <div><dt><kbd>Alt</kbd> + <kbd>N</kbd></dt><dd>Open or close notes</dd></div>
      <div><dt><kbd>Alt</kbd> + <kbd>H</kbd></dt><dd>Toggle semantic colours</dd></div>
      <div><dt><kbd>Alt</kbd> + <kbd>D</kbd></dt><dd>Toggle page brightness</dd></div>
      <div><dt><kbd>Alt</kbd> + <kbd>C</kbd></dt><dd>Toggle code brightness</dd></div>
      <div><dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>Move through a focused code trace</dd></div>
      <div><dt><kbd>Home</kbd> <kbd>End</kbd></dt><dd>First or final step in a focused trace</dd></div>
      <div><dt><kbd>Escape</kbd></dt><dd>Close this guide or an open panel</dd></div>
    </dl>
    <p>Reader shortcuts pause while you type in a text field.</p>
  </dialog>
  <p class="reader-support__status" data-reader-support-status role="status" aria-live="polite"></p>
</div>
<script>
  import { mountReaderSupport } from '../scripts/reader-support';
  mountReaderSupport();
</script>
