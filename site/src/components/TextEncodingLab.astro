---
// Type a few plain ASCII characters and watch them become bytes (decimal, hex, binary) and then Base64, with the 6-bit regrouping
// and the = padding shown step by step. The worked example HI is server-rendered in full; the script re-renders from the same
// pure model and the same HTML function when the text changes.
import { MAX_CHARS, encode } from '../lib/text-encoding';
import { outputHtml, resultText } from '../lib/text-encoding-view';
import '../styles/memory-diagrams.css';
import '../styles/text-encoding.css';
interface Props { id?: string; title?: string; initial?: string }
const { id = 'text-encoding-lab', title = 'From characters to bytes to Base64', initial = 'HI' } = Astro.props;
const encoding = encode(initial);
const presets = ['HI', 'A', 'Hi!', 'Game', 'Hello', 'abc123'] as const;
---
<figure class="mdg te not-content" id={id} data-te data-te-max={MAX_CHARS} aria-labelledby={`${id}-title`}>
  <figcaption><strong id={`${id}-title`}>{title}</strong><span>Every character is a number, every number is one byte, and Base64 re-cuts those bytes into groups of six bits. Type up to {MAX_CHARS} plain ASCII characters, or start from the worked example.</span></figcaption>

  <form class="mdg-controls te-form" data-te-form hidden novalidate data-reader-skip>
    <label class="mdg-field"><span class="mdg-field__label">Your text (up to {MAX_CHARS} ASCII characters)</span>
      <input type="text" data-te-input value={initial} maxlength={MAX_CHARS * 2} autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby={`${id}-error`} /></label>
    <div class="te-presets" role="group" aria-label="Examples">
      {presets.map(preset => <button type="button" class="mdg-btn" data-te-preset={preset}>{preset}</button>)}
    </div>
    <p class="mdg-error" id={`${id}-error`} data-te-error role="status" aria-live="polite"></p>
  </form>

  <p class="te-current">Worked example for <code data-te-current>{initial}</code></p>
  <p class="te-result" data-te-result-wrap><span>Base64</span><code data-te-result role="status" aria-live="polite" aria-atomic="true">{resultText(encoding)}</code></p>
  <div class="te-output" data-te-output set:html={outputHtml(encoding)} />
  <noscript><p class="mdg-note">The worked example for HI above is complete without JavaScript.</p></noscript>
</figure>
<script>
  import { mountTextEncodingLabs } from '../scripts/text-encoding';
  mountTextEncodingLabs();
</script>
