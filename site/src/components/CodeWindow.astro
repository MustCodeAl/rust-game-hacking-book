---
import { Code } from '@astrojs/starlight/components';

interface Props {
	code: string;
	language?: string;
	filename?: string;
	label?: string;
	mark?: string | string[];
}
const { code, language = 'text', filename, label, mark } = Astro.props;
const languageLabels: Record<string, string> = {
	rust: 'Rust', asm: 'x86 assembly', nasm: 'x86 assembly', text: 'Text',
	powershell: 'PowerShell', ps1: 'PowerShell', bash: 'Shell', sh: 'Shell',
	toml: 'TOML', json: 'JSON', c: 'C', cpp: 'C++', ts: 'TypeScript', js: 'JavaScript',
};
const name = languageLabels[language] ?? language;
const title = filename ? `${name} · ${filename}` : name;
---

<figure class="reader-code-window" aria-label={label ?? title}>
	<Code code={code} lang={language} title={title} mark={mark} />
</figure>

<style>
	.reader-code-window { margin-block: var(--reader-block-gap, 1.5rem); }
	.reader-code-window :global(.expressive-code) { margin: 0; }
	@media print { .reader-code-window { break-inside: avoid; } }
</style>
