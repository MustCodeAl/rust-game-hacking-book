---
// One card per chapter that has lessons, so a new chapter appears here as
// soon as its first lesson exists. Each card says how many lessons the chapter
// holds and roughly how long it takes to study, in the chapter's colour, and
// how many of them this reader has marked done (filled in by reader-progress.js).
import { getCollection } from 'astro:content';
import { CHAPTERS, chapterTone, compareLessons } from '../../data/chapters.mjs';
import { chapterLessonIds } from '../../lib/lessons';
import ColourKey from '../ColourKey.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessons = await getCollection('docs', (entry) => Boolean(entry.data.chapter));

const stats = new Map<number, { count: number; minutes: number }>();
for (const entry of lessons) {
	const number = Number.parseInt(entry.data.chapter!.split('.')[0], 10);
	const current = stats.get(number) ?? { count: 0, minutes: 0 };
	current.count += 1;
	current.minutes += Number(entry.data.minutes ?? 0);
	stats.set(number, current);
}
const chapters = CHAPTERS.filter((chapter) => stats.has(chapter.number));
const firstLesson = new Map(chapters.map((chapter) => [
	chapter.number,
	lessons
		.filter((entry) => entry.data.chapter!.startsWith(`${chapter.number}.`))
		.sort((a, b) => compareLessons(a.data.chapter, b.data.chapter))[0].id,
]));

function readingTime(minutes: number) {
	if (minutes < 60) return `${minutes} min`;
	const hours = Math.round((minutes / 60) * 2) / 2;
	return `about ${hours} h`;
}

const lessonIds = new Map(
	await Promise.all(chapters.map(async ({ number }) => [number, (await chapterLessonIds(number)).join(' ')] as const)),
);
---

<div class="section-heading not-content" id="course-map">
	<span>Course map</span>
	<h2>{chapters.length} chapters, one idea at a time</h2>
	<p>You do not need to know the language yet. The early lessons teach each piece right before you use it.</p>
</div>

<ColourKey />

<div class="course-grid not-content">
	{
		chapters.map((chapter) => {
			const { count, minutes } = stats.get(chapter.number)!;
			return (
				<a class="course-card" data-tone={chapterTone(chapter.number)} href={`${base}/${firstLesson.get(chapter.number)}/`}>
					<span class="course-card__top">
						<span class="course-card__emoji" aria-hidden="true">
							{chapter.emoji}
						</span>
						<span class="course-card__number">Chapter {String(chapter.number).padStart(2, '0')}</span>
					</span>
					<h3>{chapter.title}</h3>
					<p>{chapter.summary}</p>
					<span class="course-card__meta">
						{count} lessons · {readingTime(minutes)} of study
						<span class="course-card__progress" data-chapter-progress data-lessons={lessonIds.get(chapter.number)}>
							<span data-progress-text></span>
						</span>
					</span>
				</a>
			);
		})
	}
</div>
