---
// One card per chapter that has lessons, so a new chapter appears here as
// soon as its first lesson exists.
import { getCollection } from 'astro:content';
import { CHAPTERS } from '../../data/chapters.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessons = await getCollection('docs', (entry) => Boolean(entry.data.chapter));
const present = new Set(lessons.map((entry) => Number.parseInt(entry.data.chapter!.split('.')[0], 10)));
const chapters = CHAPTERS.filter((chapter) => present.has(chapter.number));
const rustChapters = new Set([3, 8, 12]);
---

<div class="section-heading not-content" id="course-map">
	<span>Course map</span>
	<h2>{chapters.length} chapters, one idea at a time</h2>
	<p>You do not need to know the language yet. The early lessons teach each piece right before you use it.</p>
</div>

<div class="course-grid not-content">
	{
		chapters.map((chapter) => (
			<a class:list={['course-card', { 'course-card--rust': rustChapters.has(chapter.number) }]} href={`${base}/pages/${chapter.number}/01/`}>
				<span>{String(chapter.number).padStart(2, '0')}</span>
				<h3>{chapter.title}</h3>
				<p>{chapter.summary}</p>
			</a>
		))
	}
</div>
