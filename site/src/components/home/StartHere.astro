---
// The first three things a new reader does, in order, with the lessons' real
// numbers and study times. Pages are found by their page id, which never
// changes, so a renumbered lesson keeps its step.
import { getCollection } from 'astro:content';
import { Steps } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessons = new Map((await getCollection('docs', (entry) => Boolean(entry.data.chapter))).map((entry) => [entry.id, entry]));
const page = (id: string) => {
	const entry = lessons.get(id);
	if (!entry) throw new Error(`StartHere: no lesson page ${id}`);
	return { href: `${base}/${id}/`, number: entry.data.chapter!, title: entry.data.title, minutes: entry.data.minutes ?? 0 };
};
const foundations = ['pages/1/01', 'pages/1/02', 'pages/1/03', 'pages/1/04', 'pages/1/05', 'pages/1/06'].map(page);
const lab = page('pages/1/07');
const memory = page('pages/1/08');
const scan = page('pages/1/09');
const hours = (minutes: number) => {
	const half = Math.round((minutes / 60) * 2) / 2;
	return minutes < 60 ? `${minutes} minutes` : `about ${half} hours`;
};
const firstFoundation = foundations[0]!;
const lastFoundation = foundations[foundations.length - 1]!;
---

<div class="gha-start not-content">
	<Steps>
		<ol>
			<li>
				<p class="gha-start__step">
					Read <a href={firstFoundation.href}>Lessons {firstFoundation.number} to {lastFoundation.number}</a> in order.
				</p>
				<p>
					They cover how a computer runs a game, what game state is, and your first Rust program,
					in {hours(foundations.reduce((total, lesson) => total + lesson.minutes, 0))} of reading. Nothing needs installing yet.
				</p>
			</li>
			<li>
				<p class="gha-start__step">Build the lab in <a href={lab.href}>Lesson {lab.number}, {lab.title}</a>.</p>
				<p>
					You need a Windows virtual machine with Rust, the x64dbg debugger and the Cheat Engine memory scanner.
					The lesson lists every tool and how to snapshot the machine so you can undo any experiment.
				</p>
			</li>
			<li>
				<p class="gha-start__step">
					Find your first value in <a href={memory.href}>Lessons {memory.number}</a> and <a href={scan.href}>{scan.number}</a>.
				</p>
				<p>
					The four bytes at the top of this page come from Lesson {memory.number}. In Lesson {scan.number} you find,
					test and change a gold value in the game Wesnoth while it runs.
				</p>
			</li>
		</ol>
	</Steps>
</div>
