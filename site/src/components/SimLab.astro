---
// An explorable simulation: it opens already showing a worked example with its
// explanation, and the reader changes the numbers to see why the result moves.
// Nothing is graded. The simulations are data-and-code in src/scripts/sim-labs.js.
//
//   <SimLab sim="base-rate" label="Explore how flags and base rates interact" />
interface Props {
	sim: string;
	id?: string;
	label?: string;
}
const { sim, id = `sim-${sim}`, label = 'Interactive simulation' } = Astro.props;
---

<section class="concept-lab sim-lab not-content" id={id} data-sim-lab={sim} aria-label={label} data-reader-skip>
	<p class="concept-lab__fallback">This simulation needs JavaScript. The lesson text around it works through the same numbers.</p>
</section>

<script>
	import { mountSimLabs } from '../scripts/sim-labs.js';
	mountSimLabs();
</script>

<style is:global>
	.sim-lab__controls { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 8px 0; align-items: end; }
	.sim-lab__controls label { display: grid; gap: 2px; min-width: 150px; flex: 1 1 150px; font-size: 0.85em; color: var(--ink-soft); }
	.sim-lab__controls output { font-family: var(--mono); color: var(--ink-strong); }
	.sim-lab__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 6px; margin: 8px 0; }
	.sim-lab__dots { display: flex; flex-wrap: wrap; gap: 2px; margin: 8px 0; max-width: 100%; }
	.sim-lab__dot { width: 9px; height: 9px; box-sizing: border-box; }
	.sim-lab__dot--hit { background: var(--chapter-accent); }
	.sim-lab__dot--false { border-radius: 50%; border: 2px solid var(--ink-soft); }
	.sim-lab__fields { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
	.sim-lab__chip { min-width: 0; padding: 6px 8px; border: 1px solid var(--line); border-top: 4px solid var(--chapter-accent); border-radius: 3px; background: var(--surface-alt); font-size: 0.8em; }
	.sim-lab__chip code { display: block; overflow-wrap: anywhere; font-family: var(--mono); color: var(--ink-strong); }
	.sim-lab__chip--bad { border-top-color: var(--danger); }
	.sim-lab__explain { margin: 8px 0; padding: 8px 10px; border-left: 4px solid var(--chapter-accent); background: var(--chapter-tint); color: var(--ink); }
	.sim-lab__presets { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 8px 0; }
	.sim-lab__error { color: var(--danger); margin: 4px 0; min-height: 1.2em; font-size: 0.85em; }
	.sim-lab .sim-lab__tree-editor { margin-block: 0.75rem; font-size: 0.9em; }
	.sim-lab .sim-lab__tree-editor summary { cursor: pointer; }
	.sim-lab .sim-lab__tree-editor > p { margin-block: 0.5rem; }
	.sim-lab .sim-lab__tree-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 0.6rem 0.9rem; align-items: end; margin-block: 0.6rem; }
	.sim-lab .sim-lab__tree-fields label { display: grid; gap: 0.3rem; min-width: 0; color: var(--ink-soft); }
	.sim-lab .sim-lab__tree-fields select,
	.sim-lab .sim-lab__tree-fields input[type="number"] { box-sizing: border-box; width: 100%; min-width: 0; padding: 0.4rem 0.5rem; font-size: 1em; }
	.sim-lab .sim-lab__tree-status { min-height: 1.4em; color: var(--ink); }
	.sim-lab .sim-lab__tree-status[data-tone="warn"] { border-inline-start: 0.2rem solid var(--warning); padding-inline-start: 0.6rem; }
	.sim-lab .sim-lab__tree { list-style: none; padding: 0; margin-block: 0.75rem; }
	.sim-lab .sim-lab__tree ul { list-style: none; margin: 0.35rem 0 0 1rem; padding-inline-start: 0.65rem; border-inline-start: 0.1rem solid var(--ink-soft); }
	.sim-lab .sim-lab__tree li { position: relative; margin-block: 0.35rem; }
	.sim-lab .sim-lab__tree ul > li::before { content: '→'; position: absolute; inset-inline-start: -0.75rem; inset-block-start: 0.4em; color: var(--ink-soft); font-size: 0.75em; }
	.sim-lab .sim-lab__tree-node { display: flex; justify-content: space-between; align-items: start; gap: 0.6em; box-sizing: border-box; width: 100%; padding: 0.35em 0.5em; color: var(--ink); background: var(--surface-alt); border: 0.0625rem solid var(--line); border-radius: 0.25em; text-align: start; white-space: normal; font: inherit; font-size: 0.85em; cursor: pointer; overflow-wrap: anywhere; }
	.sim-lab .sim-lab__tree-node-status { flex: 0 0 auto; color: var(--ink-strong); font-family: var(--mono); font-size: 0.85em; }
	.sim-lab .sim-lab__tree-node[data-status='success'],
	.sim-lab .sim-lab__tree-node[data-status='running'] { border-inline-start: 0.2rem solid var(--chapter-ink); background: var(--chapter-tint); }
	.sim-lab .sim-lab__tree-node.is-selected,
	.sim-lab .sim-lab__tree-node:focus-visible { outline: 0.125rem solid var(--chapter-ink); outline-offset: 0.1rem; }
	@media (prefers-reduced-motion: no-preference) { .sim-lab__dot { transition: background 0.15s; } }
</style>
