---
// A formula builder: slots in a formula take typed pieces (dragged, tapped in, set by
// a slider or typed on a small keypad) and the expression re-evaluates live with the
// numbers substituted step by step. It opens already filled in with the lesson's worked
// example. Nothing is graded. Formulas are data in src/scripts/formula-builder.js.
//
//   <FormulaBuilder formula="layer-mask" label="Explore the layer mask test" />
import { FORMULAS, workedExample } from '../scripts/formula-builder.js';

interface Props {
	formula: string;
	id?: string;
	label?: string;
}
const { formula: formulaId, id = `formula-${formulaId}`, label = 'Interactive formula builder' } = Astro.props;
const board = FORMULAS[formulaId];
if (!board) throw new Error(`FormulaBuilder: unknown formula "${formulaId}"`);
const worked = workedExample(formulaId);
---

<section class="concept-lab formula-builder not-content" id={id} data-formula-builder={formulaId} aria-label={label} data-reader-skip>
	<div class="concept-lab__body">
		<p class="concept-lab__fallback">This builder needs JavaScript. Here is the lesson&rsquo;s worked example.</p>
		{worked && (
			<p class="formula-builder__static">
				<code>{worked.symbolic}</code>: with the lesson&rsquo;s numbers, <code>{worked.steps[0]}</code>, which gives <code>{worked.steps[worked.steps.length - 1]}</code>. {worked.text}
			</p>
		)}
	</div>
</section>

<script>
	import { mountFormulaBuilders } from '../scripts/formula-builder.js';
	mountFormulaBuilders();
</script>

<style is:global>
	.formula-builder__invite { margin: 0 0 10px; color: var(--ink-soft); font-size: 0.88em; line-height: 1.5; }
	.formula-builder__static { margin: 0; font-size: 0.9em; line-height: 1.55; }
	.formula-builder__formula { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 6px 0 12px; font-family: var(--mono); }
	.formula-builder__group { display: inline-flex; flex-wrap: nowrap; align-items: center; gap: 8px; max-width: 100%; }
	.formula-builder__op { font-size: 1.2em; font-weight: 700; color: var(--chapter-ink); }
	.formula-builder__cell { position: relative; display: flex; align-items: stretch; max-width: 100%; border: 2px dashed var(--line); border-radius: 10px; background: var(--surface-alt); }
	.formula-builder__cell.is-over { border-style: solid; border-color: var(--chapter-accent); background: var(--chapter-tint); }
	.formula-builder__cell.is-fit { border-style: solid; border-color: var(--chapter-accent); }
	.formula-builder__cell.is-nofit { opacity: 0.55; }
	.formula-builder__slot { display: grid; gap: 2px; min-width: 7.5em; max-width: 100%; min-height: 44px; padding: 6px 10px; border: 0; border-radius: 8px; background: transparent; color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
	.formula-builder__slot:focus-visible, .formula-builder__chip:focus-visible, .formula-builder__clear:focus-visible { outline: 2px solid var(--chapter-accent); outline-offset: 2px; }
	.formula-builder__slot.is-active { box-shadow: inset 0 -3px 0 var(--chapter-accent); }
	.formula-builder__slot.is-filled { background: var(--chapter-tint); }
	.formula-builder__slot-label { color: var(--chapter-ink); font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
	.formula-builder__slot-value { color: var(--ink-strong); font-size: 0.85em; overflow-wrap: anywhere; }
	.formula-builder__clear { align-self: flex-start; min-width: 28px; min-height: 28px; margin: 2px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--ink-soft); font-size: 1.1em; cursor: pointer; }
	.formula-builder__clear[hidden] { display: none; }
	.formula-builder__bank { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 8px; margin: 6px 0 12px; }
	.formula-builder__piece { display: grid; gap: 4px; min-width: 0; padding: 6px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-alt); }
	.formula-builder__piece input[type='range'] { width: 100%; min-width: 0; margin: 0; }
	.formula-builder__chip { min-height: 36px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); font-family: var(--mono); font-size: 0.8em; text-align: left; overflow-wrap: anywhere; cursor: grab; }
	.formula-builder__chip:hover { border-color: var(--chapter-ink); }
	.formula-builder__chip.is-picked { outline: 3px solid var(--chapter-accent); outline-offset: 1px; background: var(--chapter-tint); color: var(--ink-strong); }
	.formula-builder__chip.is-dragging { opacity: 0.45; }
	.formula-builder__keypad { margin: 0 0 10px; }
	.formula-builder__keys { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
	.formula-builder__keys .concept-lab__example { min-width: 40px; min-height: 40px; }
	.formula-builder__keys .concept-lab__example:disabled { opacity: 0.5; cursor: not-allowed; }
	.formula-builder__steps { margin: 8px 0; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-alt); }
	.formula-builder__stepper { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
	.formula-builder__stepper li { display: grid; gap: 2px; min-width: 0; }
	.formula-builder__step-label { color: var(--ink-soft); font-size: 0.75em; }
	.formula-builder__stepper code { display: block; max-width: 100%; overflow-x: auto; padding: 2px 4px; color: var(--ink-strong); font-family: var(--mono); font-size: 0.9em; white-space: pre-wrap; overflow-wrap: anywhere; }
	.formula-builder__step { margin: 0; color: var(--ink-soft); }
	.formula-builder__result { margin: 8px 0 0; color: var(--ink-strong); font-size: 1.05em; overflow-wrap: anywhere; }
	.formula-builder__result strong { font-family: var(--mono); }
	.formula-builder__note { margin: 6px 0; padding: 0; min-height: 1.4em; color: var(--ink-soft); font-size: 0.88em; line-height: 1.5; }
	.formula-builder__note.is-amber { padding: 6px 8px; border-left: 4px solid var(--warning); background: color-mix(in srgb, var(--warning) 12%, var(--surface)); color: var(--ink); }
	.formula-builder__explain { margin: 8px 0; padding: 8px 10px; border-left: 4px solid var(--chapter-accent); background: var(--chapter-tint); color: var(--ink); line-height: 1.5; }
	.formula-builder__explain:empty { display: none; }
	.formula-builder__actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0; }
	@media (prefers-reduced-motion: no-preference) { .formula-builder__cell, .formula-builder__chip { transition: background-color 0.15s, border-color 0.15s, opacity 0.15s; } }
</style>
