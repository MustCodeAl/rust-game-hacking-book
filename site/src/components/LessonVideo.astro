---
// Native video controls work without JavaScript. Captions here describe the
// silent historical recording; the nearby lesson explains its mechanism.
interface Props {
	title: string;
	src: string;
	poster?: string;
	caption: string;
	duration?: string;
	type?: string;
}
const { title, src, poster, caption, duration, type = 'video/mp4' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => path.startsWith('/') && !path.startsWith('//') && path !== base && !path.startsWith(`${base}/`) ? `${base}${path}` : path;
const videoSrc = withBase(src);
const posterSrc = poster && withBase(poster);
---

<figure class="lesson-video not-content">
	<video controls playsinline preload="metadata" poster={posterSrc} aria-label={title}>
		<source src={videoSrc} type={type} />
		Your browser cannot play this video. <a href={videoSrc}>Download {title}</a> to watch it in a video player.
	</video>
	{posterSrc && <img class="lesson-video__print-poster" src={posterSrc} alt={`Still image accompanying ${title}`} loading="lazy" decoding="async" />}
	<figcaption>
		<strong>{title}</strong>
		<span class="lesson-video__meta">Silent demonstration{duration && ` · ${duration}`}</span>
		<p>{caption}</p>
		<a class="lesson-video__download" href={videoSrc} download>Download {title} video</a>
	</figcaption>
</figure>

<style>
	.lesson-video { margin: 2rem 0; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
	.lesson-video video { display: block; width: 100%; max-height: 34rem; margin: 0; background: var(--night); }
	.lesson-video figcaption { display: grid; gap: 0.4rem; padding: 1rem 1.2rem; color: var(--ink); }
	.lesson-video figcaption > strong { color: var(--ink-strong); font-size: 0.98rem; }
	.lesson-video__meta { color: var(--ink-soft); font-family: var(--mono); font-size: 0.72rem; }
	.lesson-video figcaption p { margin: 0.3rem 0; font-size: 0.88rem; }
	.lesson-video__download { width: fit-content; color: var(--chapter-ink); font-size: 0.85rem; text-underline-offset: 0.2em; }
	.lesson-video__download:focus-visible { outline: 2px solid var(--chapter-ink); outline-offset: 4px; }
	.lesson-video__print-poster { display: none; }
	@media print {
		.lesson-video { break-inside: avoid; border-color: currentColor; background: transparent; }
		.lesson-video video { display: none; }
		.lesson-video__print-poster { display: block; width: 100%; max-height: 18rem; object-fit: contain; }
		.lesson-video figcaption { padding: 0.6rem; }
	}
</style>
