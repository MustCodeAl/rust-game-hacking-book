---
import '../styles/reading-audio.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<details class="reading-audio" data-reading-audio data-audio-base={`${base}/assets/audio/`} data-reader-skip>
	<summary>Reading sound <span data-audio-summary>Off</span></summary>
	<div class="reading-audio__row">
		<label>Background
			<select data-audio-track aria-label="Background sound">
				<option value="soft-music">Soft music</option>
				<option value="quiet-rain">Quiet rain</option>
			</select>
		</label>
		<button type="button" data-audio-play aria-label="Play background sound">Play</button>
		<button type="button" data-audio-stop disabled>Stop</button>
	</div>
	<div class="reading-audio__row">
		<label>Volume <input data-audio-volume aria-label="Reading sound volume" type="range" min="0" max="100" value="20" /></label>
		<label><input data-audio-effects type="checkbox" />Soft button sounds</label>
	</div>
	<p data-audio-status role="status" aria-live="polite">Sound starts off. Play when you want it.</p>
	<small>Original sounds, released into the public domain under CC0.</small>
</details>

<script>
	import { mountReadingAudio } from '../scripts/reading-audio.js';
	mountReadingAudio();
</script>
