---
interface Props { readerUrl: string; title: string }
const { readerUrl, title } = Astro.props;
---
<div class="read-here" data-read-here data-reader-url={readerUrl} data-reader-skip role="group" aria-label={`Read ${title} aloud on this page`}>
  <button type="button" data-read-here-play disabled>Read here</button>
  <button type="button" data-read-here-stop hidden>Stop</button>
  <span data-read-here-status role="status" aria-live="polite"></span>
  <noscript>Use the listening edition link for read-aloud tools.</noscript>
</div>
<script>
  import { mountReadHere } from '../scripts/read-here';
  mountReadHere();
</script>
<style>
  .read-here { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: .82rem; }
  .read-here button { padding: .3rem .6rem; border: .0625rem solid var(--line); border-radius: .3rem; background: var(--reader-panel, var(--paper)); color: var(--chapter-ink); font: inherit; cursor: pointer; }
  .read-here button:focus-visible { outline: .125rem solid var(--chapter-accent); outline-offset: .125rem; }
  .read-here button:disabled { cursor: default; opacity: .65; }
  .read-here [hidden] { display: none; }
  .read-here [role='status'] { color: var(--ink-soft); }
  @media print { .read-here { display: none; } }
</style>
