---
// Read the lesson aloud without leaving the page. Starting reveals a compact player pinned to the bottom of the screen.
interface Props { readerUrl: string; title: string }
const { readerUrl, title } = Astro.props;
---
<div class="read-here" data-read-here data-reader-url={readerUrl} data-reader-skip role="group" aria-label={`Read ${title} aloud on this page`}>
  <button type="button" class="read-here__start" data-read-here-play disabled>Read here</button>
  <span class="read-here__status" data-read-here-status role="status" aria-live="polite"></span>
  <div class="read-here__bar" data-read-here-bar role="region" aria-label="Read aloud controls" hidden>
    <p class="read-here__now" data-read-here-now aria-hidden="true"></p>
    <progress class="read-here__progress" data-read-here-progress max="1" value="0" aria-label="Reading progress"></progress>
    <div class="read-here__row">
      <button type="button" data-read-here-back disabled title="Back to the start of this paragraph, or the one before it" aria-label="Previous paragraph">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 5h2.4v14H6zM19 5.5v13L9.6 12z" /></svg>
      </button>
      <button type="button" class="read-here__main" data-read-here-toggle aria-label="Pause reading">
        <svg data-read-here-icon-play viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M7 4.5v15l12-7.5z" /></svg>
        <svg data-read-here-icon-pause viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 5h4v14h-4zM13.5 5h4v14h-4z" /></svg>
        <span data-read-here-toggle-label>Pause</span>
      </button>
      <button type="button" data-read-here-forward disabled title="Forward to the next paragraph" aria-label="Next paragraph">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.6 5H18v14h-2.4zM5 5.5v13L14.4 12z" /></svg>
      </button>
      <button type="button" class="read-here__speed" data-read-here-speed title="Reading speed: press to change">1×</button>
      <button type="button" class="read-here__cc" data-read-here-captions aria-pressed="false" title="Captions: show the words being read">CC</button>
      <details class="read-here__voice">
        <summary>Voice</summary>
        <div class="read-here__voice-panel">
          <label>Voice <select data-read-here-voice aria-label="Read-aloud voice"><option value="">Browser default</option></select></label>
          <button type="button" data-read-here-sample>Hear a sample</button>
          <label>Caption size <select data-read-caption-opt="size" aria-label="Caption size"><option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option></select></label>
          <label>Caption style <select data-read-caption-opt="look" aria-label="Caption style"><option value="dark">Dark bar</option><option value="light">Light bar</option><option value="yellow">Yellow on black</option><option value="outline">Text only</option></select></label>
          <label>Caption position <select data-read-caption-opt="pos" aria-label="Caption position"><option value="bottom">Bottom</option><option value="top">Top</option></select></label>
        </div>
      </details>
      <button type="button" class="read-here__stop" data-read-here-stop title="Stop reading">Stop</button>
    </div>
  </div>
  <noscript>Use the listening edition link for read-aloud tools.</noscript>
</div>
<script>
  import { mountReadHere } from '../scripts/read-here';
  mountReadHere();
</script>
<style>
  .read-here { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: .88rem; }
  .read-here button, .read-here summary { min-height: 2.75rem; padding: .35rem .8rem; border: .0625rem solid var(--line); border-radius: .5rem; background: var(--reader-panel, var(--paper)); color: var(--chapter-ink, var(--ink)); font: inherit; cursor: pointer; }
  .read-here__start { font-weight: 700; }
  .read-here svg { width: 1.1rem; height: 1.1rem; fill: currentColor; flex: none; }
  .read-here__cc { font-weight: 800; letter-spacing: .04em; }
  .read-here__cc[aria-pressed='true'] { background: var(--chapter-accent, var(--ink)); border-color: var(--chapter-accent, var(--ink)); color: var(--paper); }
  /* The captions themselves live on the page, outside the player: see the global block below. */
  .read-here svg[hidden] { display: none; }
  .read-here button:focus-visible, .read-here summary:focus-visible, .read-here select:focus-visible { outline: .15rem solid var(--chapter-accent); outline-offset: .15rem; }
  .read-here button:disabled { cursor: default; opacity: .6; }
  .read-here [hidden] { display: none !important; }
  .read-here__status { color: var(--ink-soft); }
  .read-here__bar { position: fixed; z-index: 80; right: 0; bottom: 0; left: 0; display: grid; gap: .45rem; padding: .6rem .75rem calc(.6rem + env(safe-area-inset-bottom)); border-top: .125rem solid var(--chapter-accent, var(--line)); background: var(--paper); box-shadow: 0 -.5rem 1.5rem color-mix(in oklch, var(--ink) 12%, transparent); font-size: .85rem; }
  .read-here__now { margin: 0; color: var(--ink-soft); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 1.35em; }
  .read-here__progress { width: 100%; height: .4rem; accent-color: var(--chapter-accent); }
  .read-here__row { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
  .read-here__row > button, .read-here__row summary { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; min-width: 2.75rem; }
  .read-here__main { background: var(--chapter-accent) !important; border-color: var(--chapter-accent) !important; color: var(--chapter-on-accent, var(--paper)) !important; font-weight: 700; }
  .read-here__speed { font-variant-numeric: tabular-nums; font-weight: 700; }
  .read-here__voice summary { list-style: none; }
  .read-here__voice summary::-webkit-details-marker { display: none; }
  .read-here__voice-panel { position: absolute; bottom: calc(100% + .5rem); left: .75rem; right: .75rem; display: grid; gap: .5rem; max-width: 24rem; padding: .75rem; border: .0625rem solid var(--line); border-radius: .5rem; background: var(--paper); box-shadow: 0 .5rem 1.5rem color-mix(in oklch, var(--ink) 18%, transparent); }
  .read-here__voice-panel label { display: grid; gap: .25rem; }
  .read-here__voice-panel select { min-height: 2.75rem; width: 100%; padding: .35rem .5rem; border: .0625rem solid var(--line); border-radius: .35rem; background: var(--paper); color: var(--ink); font: inherit; }
  .read-here__stop { margin-left: auto; }
  :global(html[data-read-player='on'] body) { padding-bottom: calc(var(--read-player-height, 6rem) + 1rem); }
  @media (max-width: 47.99rem) { :global(html[data-read-player='on']) :global(:is(.lesson-notes__fab, #context7-widget)) { transform: translateY(calc(-1 * var(--read-player-height, 6rem))); } }
  @media (min-width: 48rem) { .read-here__bar { right: auto; left: 50%; bottom: 1rem; width: min(40rem, calc(100vw - 2rem)); transform: translateX(-50%); border: .0625rem solid var(--line); border-top: .125rem solid var(--chapter-accent, var(--line)); border-radius: .75rem; } }
  @media print { .read-here { display: none; } }
</style>
<style is:global>
  /* Captions for the read-aloud, drawn over the page like video captions (built by read-here.ts). */
  .read-caption { position: fixed; left: var(--cap-center, 50%); transform: translateX(-50%); z-index: 70; box-sizing: border-box; width: min(var(--cap-width, 40rem), 40rem, calc(100vw - 1.5rem)); max-height: 40vh; overflow: hidden; padding: .55rem .9rem; border-radius: .5rem; text-align: center; font: 600 1.2rem/1.45 system-ui, sans-serif; text-wrap: balance; cursor: pointer; }
  .read-caption:hover { outline: .15rem solid var(--chapter-accent, #d97706); outline-offset: .1rem; }
  .read-caption-target { outline: .2rem solid var(--chapter-accent, #d97706); outline-offset: .35rem; border-radius: .25rem; }
  .read-caption[data-pos='bottom'] { bottom: calc(var(--read-player-height, 0px) + 1rem); }
  .read-caption[data-pos='top'] { top: 4.5rem; }
  .read-caption[data-size='small'] { font-size: 1rem; }
  .read-caption[data-size='large'] { font-size: 1.65rem; }
  .read-caption[data-mode='passage'] { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; }
  .read-caption[data-look='dark'] { background: rgba(8, 10, 12, .88); color: #fff; }
  .read-caption[data-look='light'] { background: rgba(255, 255, 255, .96); color: #111; box-shadow: 0 0 0 1px rgba(0, 0, 0, .3); }
  .read-caption[data-look='yellow'] { background: #000; color: #ffe94a; }
  .read-caption[data-look='outline'] { background: transparent; color: #fff; text-shadow: 0 0 .12em #000, 0 0 .12em #000, 0 0 .3em #000, 0 .06em .2em #000; }
  .read-caption[data-under='true'] { z-index: 0; }
  .read-caption[hidden] { display: none; }
  @media print { .read-caption { display: none !important; } }
</style>
