---
// Remembers which lesson and section a reader was in (see
// src/scripts/resume-reading.js); the home page's Continue button reads it.
interface Props {
	id: string;
	lesson: string;
	title: string;
}
const { id, lesson, title } = Astro.props;
---

<div hidden data-resume-record data-resume-id={id} data-resume-lesson={lesson} data-resume-title={title}></div>

<script>
	import { mountResume } from '../scripts/resume-reading.js';
	mountResume();
</script>
