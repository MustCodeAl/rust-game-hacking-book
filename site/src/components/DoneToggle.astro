---
// One lesson's "done" button. Its label always says what a click will do;
// reader-progress.js sets data-state from the saved progress on load, and only
// the label for the current state is shown or read out.
interface Props {
	/** The lesson's URL id, such as "pages/1/10". */
	id: string;
	/** The displayed lesson number, such as "2.2". */
	lesson: string;
	/** "compact" draws only the tick box, for lists of lessons. */
	variant?: 'full' | 'compact';
}

const { id, lesson, variant = 'full' } = Astro.props;
---

<button type="button" class:list={['done-toggle', `done-toggle--${variant}`]} data-done-toggle={id} data-state="todo">
	<span class="done-toggle__box" aria-hidden="true"></span>
	{
		variant === 'compact' ? (
			<>
				<span class="state-todo sr-only">Mark lesson {lesson} done</span>
				<span class="state-done sr-only">Lesson {lesson} is done. Mark it not done</span>
			</>
		) : (
			<>
				<span class="state-todo">Mark lesson done</span>
				<span class="state-done">
					Lesson done<span class="sr-only">. Mark it not done</span>
				</span>
			</>
		)
	}
</button>
