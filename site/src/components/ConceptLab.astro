---
interface Props {
	lab: string;
	id?: string;
	label?: string;
}
const { lab, id = lab, label = 'Interactive concept lab' } = Astro.props;
---

<section class="concept-lab not-content" id={id} data-concept-lab={lab} data-concept-id={id} aria-label={label}>
	<p class="concept-lab__fallback">This interactive lab needs JavaScript. The lesson text around it still explains the same idea.</p>
</section>
