---
// An animation in which the things that really move or change in the system
// move or change on the screen. Scenes live in src/scenes/<name>.ts; see
// components/kit/README.md for what makes one worth having.
//
// The page holds the finished picture and the written steps, so printing, search,
// the listening edition, and a browser without scripts all work. The script only
// adds playback and, for selected scenes, bounded inputs that recompute the model.
import { renderScene } from '../lib/scene/markup.ts';
import { playerSpec } from '../lib/scene/engine.ts';
import type { SceneModule } from '../lib/scene/types.ts';
import { inlineMarkdown } from '../lib/inline-md';
import '../styles/scene.css';

interface Props {
	name: string;
}

const { name } = Astro.props;
const scenes = import.meta.glob<SceneModule>('../scenes/*.ts', { eager: true });
const module = scenes[`../scenes/${name}.ts`];
const sc = module?.default;
if (!sc) throw new Error(`There is no scene called "${name}". Add src/scenes/${name}.ts.`);
const exploration = module?.exploration;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// One scene may appear once on a page, so its name is a stable id (a counter would change between builds).
const uid = `scene-${name}`;
const picture = renderScene(sc, sc.duration, { id: uid, base });
// "<" never appears raw inside the embedded data, so it cannot close the script early.
const spec = JSON.stringify({ ...playerSpec(sc), explore: exploration ? name : undefined }).replace(/</g, '\\u003c');
---

<figure class="scene not-content" data-scene data-scene-id={uid} data-scene-base={base} style={`--scene-w:${sc.w}`} aria-labelledby={`${uid}-title`}>
	<figcaption class="scene__top">
		<span class="scene__eyebrow">Watch it happen</span>
		<strong id={`${uid}-title`} class="scene__title">{sc.title}</strong>
	</figcaption>
	{exploration && <div class="scene__explore" data-scene-explore data-reader-skip role="group" aria-labelledby={`${uid}-explore-title`} hidden>
		<strong id={`${uid}-explore-title`}>Change the simulation</strong>
		<p class="scene__invite">{exploration.invite}</p>
		<div class="scene__fields">
			{exploration.fields.map((field) => <label class:list={['scene__field', { 'scene__field--check': field.type === 'checkbox' }]} for={`${uid}-${field.key}`}>
				{field.type === 'checkbox'
					? <><input id={`${uid}-${field.key}`} data-scene-input={field.key} type="checkbox" checked={field.start} /><span>{field.label}</span></>
					: <><span>{field.label} <output for={`${uid}-${field.key}`} data-scene-output={field.key}>{field.start}{field.unit || ''}</output></span><input id={`${uid}-${field.key}`} data-scene-input={field.key} type="range" min={field.min} max={field.max} step={field.step} value={field.start} /></>}
			</label>)}
		</div>
		<div class="scene__controls"><button type="button" data-scene-reset>Reset</button></div>
		<p class="scene__result" data-scene-result role="status"></p>
	</div>}
	<div class="scene__stage">
		<svg class="scene__svg" viewBox={`0 0 ${sc.w} ${sc.h}`} aria-hidden="true" focusable="false" set:html={picture} />
	</div>
	<p class="scene__alt">{sc.alt}</p>
	<p class="scene__cue" data-scene-cue data-reader-skip hidden></p>
	<div class="scene__controls" data-scene-controls data-reader-skip hidden>
		<button type="button" data-scene-action="play">Play</button>
		<button type="button" data-scene-action="prev" aria-label="Previous step">‹ Step</button>
		<button type="button" data-scene-action="next" aria-label="Next step">Step ›</button>
		<button type="button" data-scene-action="restart">Restart</button>
		<button type="button" data-scene-action="speed" aria-label="Playback speed: 1×">1×</button>
		<input class="scene__scrub" data-scene-scrub type="range" min="0" max="1000" value="0" aria-label="Position in the animation" />
	</div>
	<p class="scene__live" data-scene-live role="status" aria-live="polite"></p>
	<details class="scene__steps">
		<summary>Read the steps</summary>
		<ol>
			{sc.cues.map(([, words]: [number, string]) => <li set:html={inlineMarkdown(words)} />)}
		</ol>
	</details>
	{sc.caption && <p class="scene__caption" set:html={inlineMarkdown(sc.caption)} />}
	<script type="application/json" data-scene-spec set:html={spec} />
</figure>

<script>
	import { mountScenes } from '../lib/scene/runtime.js';
	mountScenes(document);
	document.addEventListener('astro:page-load', () => mountScenes(document));
</script>

<style>
	.scene__explore { margin-block: .6rem; font-size: .85rem; }
	.scene__invite { margin: .35rem 0 .6rem; line-height: 1.5; }
	.scene__fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: .6rem .8rem; }
	.scene__field { display: grid; min-width: 0; gap: .3rem; }
	.scene__field--check { display: flex; align-items: center; gap: .4em; }
	.scene__field input[type='range'] { width: 100%; margin: 0; accent-color: var(--reading-process); }
	.scene__field input[type='checkbox'] { margin: 0; accent-color: var(--reading-process); }
	.scene__field output { margin-inline-start: .35em; font-family: var(--mono); color: var(--diagram-ink-strong); }
	.scene__result { margin: .35rem 0 0; padding-inline-start: .6em; border-inline-start: .15em solid var(--reading-result); line-height: 1.5; }
	@media print { .scene__explore { display: none !important; } }
</style>
