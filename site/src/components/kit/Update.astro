---
interface Props {
	/** The date or version, such as "3 October 2026". */
	label: string;
	/** Short tags for what changed, separated by commas. */
	tags?: string;
	/** One line saying what the entry is about. */
	description?: string;
}

const { label, tags, description } = Astro.props;
const tagList = tags?.split(',').map((tag) => tag.trim()).filter(Boolean) ?? [];
---

<article class="kit-update">
	<p class="kit-update__head">
		<strong class="kit-update__label">{label}</strong>
		{tagList.map((tag) => <span class="kit-update__tag">{tag}</span>)}
	</p>
	{description && <p class="kit-update__description">{description}</p>}
	<div class="kit-update__body"><slot /></div>
</article>
