---
// Starlight's LinkCard, with the site's base path added to links that start
// with /, so a lesson can write href="/pages/2/01/" like it does in Markdown.
import { LinkCard as StarlightLinkCard } from '@astrojs/starlight/components';

interface Props {
	title: string;
	description?: string;
	href: string;
}

const { href, ...rest } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = href.startsWith('/') && !href.startsWith('//') ? `${base}${href}` : href;
---

<StarlightLinkCard {...rest} href={to} />
