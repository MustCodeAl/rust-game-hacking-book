---
// A reference box a reader may want to keep in view or come back to: a cheat
// sheet, a table of values, a list of terms for the section.
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="kit-panel" role="group" aria-label={title}>
	<p class="kit-panel__title"><strong>{title}</strong></p>
	<div class="kit-panel__body"><slot /></div>
</div>
