---
// A lighter collapsible for detail inside something else, such as the fields of
// a structure listed under a parameter. Use Accordion for a section of a lesson.
interface Props {
	title: string;
	open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="kit-expandable" open={open}>
	<summary class="not-content">{title}</summary>
	<div class="kit-expandable__body"><slot /></div>
</details>
