---
// What a function or request gives back, or one field of the result.
interface Props {
	name: string;
	type?: string;
}

const { name, type } = Astro.props;
---

<div class="kit-field" data-kind="response">
	<p class="kit-field__head">
		<code class="kit-field__name">{name}</code>
		{type && <span class="kit-field__type">{type}</span>}
	</p>
	<div class="kit-field__body"><slot /></div>
</div>
