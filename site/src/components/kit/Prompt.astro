---
// A prompt a reader can copy and paste into an AI assistant, with a button to
// copy it and links that open it in an assistant. kit.js adds the buttons; the
// links send the prompt to that assistant only when clicked.
interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<section class="kit-prompt" data-kit-prompt>
	<p class="kit-prompt__head">
		<span class="kit-prompt__label">Prompt</span>
		{title && <strong class="kit-prompt__title">{title}</strong>}
	</p>
	<div class="kit-prompt__text" data-kit-prompt-text><slot /></div>
</section>
