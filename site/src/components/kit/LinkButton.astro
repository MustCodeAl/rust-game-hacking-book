---
// Starlight's LinkButton, with the site's base path added to links that start with /.
import { LinkButton as StarlightLinkButton } from '@astrojs/starlight/components';

interface Props {
	href: string;
	variant?: 'primary' | 'secondary' | 'minimal';
	icon?: string;
}

const { href, ...rest } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = href.startsWith('/') && !href.startsWith('//') ? `${base}${href}` : href;
---

<StarlightLinkButton {...rest} href={to}><slot /></StarlightLinkButton>
