---
// A colour swatch with its value, for the lessons that show colours as numbers.
interface Props {
	/** A CSS colour: #rrggbb, rgb(...), or hsl(...). */
	value: string;
	name?: string;
}

const { value, name } = Astro.props;
if (!/^(#[0-9a-f]{3,8}|(rgb|hsl)a?\([0-9a-z%.,\s/-]+\))$/i.test(value)) {
	throw new Error(`<Color> needs a #hex, rgb(), or hsl() value, not ${JSON.stringify(value)}.`);
}
---

<span class="kit-color">
	<span class="kit-color__swatch" style={`--swatch: ${value}`} aria-hidden="true"></span>
	<code class="kit-color__value">{value}</code>
	{name && <span class="kit-color__name">{name}</span>}
</span>
