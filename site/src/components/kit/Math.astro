---
// Maths from a TeX string, drawn while building. Most formulas are simpler to
// write in the lesson as $$ ... $$; use this when the formula needs a
// reading for the listening edition that the automatic one gets wrong, or when
// it sits inside a component.
import { renderMath } from '../../lib/math.mjs';

interface Props {
	tex: string;
	/** On a line of its own, larger. */
	block?: boolean;
	/** The formula in words, read aloud in the listening edition. */
	speak?: string;
}

const { tex, block = false, speak } = Astro.props;
---

<Fragment set:html={renderMath(tex, { display: block, speak })} />
