---
// A code block a reader can type out as practice, the way speedtyper.dev does:
// the code is shown dimmed, each correct key lights it up, and the result is
// words per minute and accuracy. Put one fenced code block inside. The block is
// complete without scripts, so printing, search, and the listening edition keep
// reading it as ordinary code; public/scripts/speedtype.js adds the button.
//
//   <SpeedType id="bfs-test" title="Type the BFS test">
//   ```rust
//   fn main() {}
//   ```
//   </SpeedType>
//
// `id` is the practice's name for remembering a reader's best; keep it unique.
// Optional `recall` hides authored fragments only in a second practice mode.
// The complete reading block and ordinary copy-typing practice stay available.
interface Props {
	id: string;
	title?: string;
	recall?: Array<{ text: string; hint: string }>;
}

const { id, title = 'this code', recall } = Astro.props;
const recallData = recall?.length ? JSON.stringify(recall) : undefined;
---

<div class="kit-speedtype" data-speedtype data-speedtype-id={id} data-speedtype-title={title} data-speedtype-recall={recallData}>
	<slot />
</div>
