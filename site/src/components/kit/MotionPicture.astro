---
// Optional original motion artwork. The authored source is always a still, so
// print and the listening edition retain an image without playback controls.
import '../../styles/motion-picture.css';

interface Props {
	id: string;
	still: string;
	motion: string;
	alt: string;
	caption?: string;
	width: number;
	height: number;
}

const { id, still, motion, alt, caption, width, height } = Astro.props;
if (!id || !alt || !(width > 0) || !(height > 0)) throw new Error('MotionPicture needs id, alt, width and height.');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<figure class="motion-picture not-content" data-motion-picture data-still={asset(still)} data-motion={asset(motion)} style={`--motion-picture-width:${width}px`}>
	<img id={`${id}-picture`} data-motion-image src={asset(still)} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
	<div class="motion-picture__controls" data-reader-skip>
		<button type="button" data-motion-toggle aria-label="Play animation" aria-pressed="false" aria-controls={`${id}-picture`} hidden>Play</button>
		<span class="motion-picture__status" data-motion-status role="status" aria-live="polite"></span>
	</div>
	{caption && <figcaption class="motion-picture__caption" data-reader-skip>{caption}</figcaption>}
</figure>

<script is:inline src={`${base}/scripts/motion-picture.js`} defer></script>
