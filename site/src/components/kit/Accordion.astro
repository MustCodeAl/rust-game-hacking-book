---
// A collapsible section for material a reader may skip on a first pass: a
// listing, an optional check, a closer look. A closed accordion still holds all
// of its text in the page, so search, printing, and the listening edition
// include it (kit.js opens every accordion while printing).
interface Props {
	title: string;
	/** Start open. Most accordions start closed. */
	open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="kit-accordion" open={open}>
	<summary class="not-content"><span class="kit-accordion__title">{title}</span></summary>
	<div class="kit-accordion__body"><slot /></div>
</details>
