---
interface Props {
	title: string;
	/** Where the tile goes. A path starting with / is inside the book. */
	href?: string;
	/** An image from public/, such as /assets/images/1/example.png. */
	image?: string;
	alt?: string;
}

const { title, href, image, alt = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inBook = (path?: string) => (path?.startsWith('/') && !path.startsWith('//') ? `${base}${path}` : path);
const Tag = href ? 'a' : 'div';
---

<Tag class="kit-tile" href={inBook(href)}>
	{image && <img class="kit-tile__image" src={inBook(image)} alt={alt} loading="lazy" decoding="async" />}
	<p class="kit-tile__title"><strong>{title}</strong></p>
	<div class="kit-tile__body"><slot /></div>
</Tag>
