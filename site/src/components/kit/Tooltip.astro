---
// A short explanation that opens over a word or phrase when it is hovered,
// focused, or tapped: a HoverCard of kind "explanation". A glossary word needs
// none: the build marks those itself. HoverCard has the other kinds (example,
// reference, tip, alternative, recommendation) and can carry a heading and a link.
import HoverCard from './HoverCard.astro';

interface Props {
	tip: string;
}

const { tip } = Astro.props;
---

<HoverCard kind="explanation" body={tip}><slot /></HoverCard>
