---
// A worked example set apart from the explanation around it: a concrete input,
// the steps, and the result.
interface Props {
	title?: string;
	/** The small label in the corner. */
	label?: string;
}

const { title, label = 'Example' } = Astro.props;
---

<section class="kit-example">
	<p class="kit-example__head">
		<span class="kit-example__label">{label}</span>
		{title && <strong class="kit-example__title">{title}</strong>}
	</p>
	<div class="kit-example__body"><slot /></div>
</section>
