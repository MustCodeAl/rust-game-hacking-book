---
// Alternatives for one job: two operating systems, two languages, two tools.
// Every panel is plain content in the page. Without JavaScript, and in print,
// search, and the listening edition, all of them are shown one after another,
// each under its label. kit.js turns them into tabs on lesson pages. A reader's
// choice is remembered and shared by every Tabs with the same `sync` key.
interface Props {
	/** Tabs that share a key switch together, such as "os". */
	sync?: string;
	/** "code" joins the tabs to the code block under them. */
	variant?: 'default' | 'code';
}

const { sync, variant = 'default' } = Astro.props;
---

<div class:list={['kit-tabs', variant === 'code' && 'kit-tabs--code']} data-kit-tabs data-sync={sync}>
	<slot />
</div>
