---
// Content side by side, one Column per cell: a before and an after, two cases,
// source and bytes. The columns stack on narrow screens, in reading order.
interface Props {
	cols?: 2 | 3 | 4;
}

const { cols = 2 } = Astro.props;
---

<div class="kit-columns" style={`--kit-columns: ${cols}`}><slot /></div>
