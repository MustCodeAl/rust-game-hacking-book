---
// A card for a file in this book's repository, usually a lab: its name, how
// long it is, and links to the exact version on GitHub and, for the lab
// folders, to the copy the book serves. The line count and the link are made
// while building, so they always match the file the lesson describes.
import { Icon } from '@astrojs/starlight/components';
import { sourceInfo } from '../../lib/github.mjs';

interface Props {
	/** A path from the repository root, such as windows-labs/src/bin/access_probe.rs. */
	path: string;
	title?: string;
}

const { path, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { lines, language, githubUrl, served } = sourceInfo(path);
const name = path.split('/').at(-1);
const folder = path.split('/').slice(0, -1).join('/');
---

<div class="kit-github" data-reader-skip>
	<span class="kit-github__icon" aria-hidden="true"><Icon name="github" size="1.5rem" /></span>
	<div class="kit-github__info">
		<p class="kit-github__title"><strong>{title ?? name}</strong></p>
		<p class="kit-github__meta"><code>{folder}/</code> · {language}, {lines} lines</p>
	</div>
	<p class="kit-github__links">
		<a href={githubUrl} rel="noopener">View on GitHub<span aria-hidden="true"> ↗</span></a>
		{served && <button type="button" class="kit-github__toggle" aria-expanded="false" data-github-src={`${base}/${path}`}>Show the code</button>}
	</p>
	{served && (
		<div class="kit-github__code" hidden>
			<pre tabindex="0"><code></code></pre>
		</div>
	)}
</div>

<script>
	// Shows a lab's source in place. The file is fetched the first time it is
	// asked for, so a page with many cards stays light, and nothing is saved to
	// the reader's computer.
	document.addEventListener('click', async event => {
		const button = event.target instanceof Element ? event.target.closest('[data-github-src]') : null;
		if (!button) return;
		const card = button.closest('.kit-github');
		const panel = card?.querySelector('.kit-github__code');
		const code = panel?.querySelector('code');
		if (!panel || !code) return;
		const open = panel.hidden;
		panel.hidden = !open;
		button.setAttribute('aria-expanded', String(open));
		button.textContent = open ? 'Hide the code' : 'Show the code';
		if (open && !code.textContent) {
			code.textContent = 'Loading…';
			try {
				const response = await fetch(button.getAttribute('data-github-src'));
				if (!response.ok) throw new Error(String(response.status));
				code.textContent = await response.text();
			} catch {
				code.textContent = 'The file could not be loaded here. Use “View on GitHub” instead.';
			}
		}
	});
</script>
