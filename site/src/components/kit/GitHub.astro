---
// A card for a file in this book's repository, usually a lab: its name, how
// long it is, and links to the exact version on GitHub and, for the lab
// folders, to the copy the book serves. The line count and the link are made
// while building, so they always match the file the lesson describes.
import { Icon } from '@astrojs/starlight/components';
import { sourceInfo } from '../../lib/github.mjs';

interface Props {
	/** A path from the repository root, such as windows-labs/src/bin/access_probe.rs. */
	path: string;
	title?: string;
}

const { path, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { lines, language, githubUrl, served } = sourceInfo(path);
const name = path.split('/').at(-1);
const folder = path.split('/').slice(0, -1).join('/');
---

<div class="kit-github" data-reader-skip>
	<span class="kit-github__icon" aria-hidden="true"><Icon name="github" size="1.5rem" /></span>
	<div class="kit-github__info">
		<p class="kit-github__title"><strong>{title ?? name}</strong></p>
		<p class="kit-github__meta"><code>{folder}/</code> · {language}, {lines} lines</p>
	</div>
	<p class="kit-github__links">
		<a href={githubUrl} rel="noopener">View on GitHub<span aria-hidden="true"> ↗</span></a>
		{served && <a href={`${base}/${path}`}>Open the file</a>}
	</p>
</div>
