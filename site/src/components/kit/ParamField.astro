---
// One parameter, argument, or field: its name, type, and what it means. The
// head is a paragraph so the listening edition reads the name and type too.
interface Props {
	name: string;
	type?: string;
	required?: boolean;
	default?: string;
}

const { name, type, required = false, default: fallback } = Astro.props;
---

<div class="kit-field" data-kind="param">
	<p class="kit-field__head">
		<code class="kit-field__name">{name}</code>
		{type && <span class="kit-field__type">{type}</span>}
		{required && <span class="kit-field__flag">required</span>}
		{fallback && <span class="kit-field__default">default <code>{fallback}</code></span>}
	</p>
	<div class="kit-field__body"><slot /></div>
</div>
