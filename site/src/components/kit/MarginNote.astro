---
import '../../styles/margin-notes.css';
// Kinds and the side they sit on (see HANDOFF_PLAN.md): LEFT explains how something works (code, alternative,
// clarification, math); RIGHT is what to keep or do (brief, narration, context, action, wonder, praise).
type Kind = 'brief' | 'alternative' | 'narration' | 'context' | 'clarify' | 'inquiry' | 'praise' | 'action' | 'code' | 'math' | 'mine';
interface Props { kind?: Kind }
const { kind = 'brief' } = Astro.props;
const label = { brief: 'TL;DR', alternative: 'Alternative', narration: 'Narration', context: 'Context', clarify: 'Clarification', inquiry: 'Wonder', praise: 'Well spotted', action: 'Try this', code: 'Code note', math: 'Math', mine: 'My note' }[kind];
---

<aside class="margin-note" data-margin-note data-kind={kind} role="note" aria-label={label} title={label}>
	<p><span class="margin-note__type">{label}: </span><slot /></p>
</aside>

<script>
	import { mountMarginNotes } from '../../scripts/margin-notes.js';
	mountMarginNotes();
</script>
