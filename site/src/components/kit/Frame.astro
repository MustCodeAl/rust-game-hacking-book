---
// A framed picture, screenshot, or figure with an optional caption. The caption
// is for the eye only. Give the source image useful alt text; listening editions
// preserve the picture silently and narrate its surrounding explanation.
interface Props {
	caption?: string;
}

const { caption } = Astro.props;
---

<figure class="kit-frame">
	<div class="kit-frame__media"><slot /></div>
	{caption && <figcaption class="kit-frame__caption" data-reader-skip>{caption}</figcaption>}
</figure>
