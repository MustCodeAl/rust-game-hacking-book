---
// Optional sign-in so a reader's progress follows them between devices.
// Nothing renders until src/data/account-config.json holds a Supabase project
// URL and its public (anon) key; see ACCOUNT_SETUP.md. The behaviour is in
// src/scripts/account.js. Progress stays in this browser either way.
import config from '../data/account-config.json';
const enabled = Boolean(config.supabaseUrl && config.anonKey);
const providers = (config.providers ?? []).filter((name: string) => ['google', 'discord', 'github'].includes(name));
---

{
	enabled && (
		<details
			class="reading-audio account-controls"
			data-account
			data-supabase-url={config.supabaseUrl.replace(/\/$/, '')}
			data-anon-key={config.anonKey}
			data-providers={providers.join(' ')}
			data-reader-skip
		>
			<summary>
				Account <span data-account-summary>Signed out</span>
			</summary>
			<div data-account-body />
			<p data-account-status role="status" aria-live="polite" />
		</details>
	)
}

<script>
	import { mountAccount } from '../scripts/account.js';
	mountAccount();
</script>

<style is:global>
	.account-controls [data-account-body] { display: grid; gap: 6px; margin: 6px 0; }
	.account-controls button { text-align: left; }
	.account-controls__who { display: flex; align-items: center; gap: 8px; min-width: 0; font-weight: 650; overflow-wrap: anywhere; }
	.account-controls__who img { width: 28px; height: 28px; border-radius: 50%; }
	.account-controls [data-account-status]:empty { display: none; }
</style>
