---
interface Props {
	example: string;
	id?: string;
}
const { example, id = example } = Astro.props;
---

<section class="ownership-scope not-content" data-ownership-example={example} data-ownership-id={id} aria-label="Interactive ownership visualization">
	<p class="ownership-scope__fallback">
		This interactive ownership model needs JavaScript. The surrounding lesson still explains every step in text.
	</p>
</section>
