---
// The listening edition's controls, in two parts that share one player.
//   - The dock holds what a listener needs at any moment: go back or forward a
//     paragraph, play or pause, stop, change the speed, see the progress, and
//     leave reader mode. It is pinned to the top of the screen through the
//     whole page (lesson-reader.css), so a lesson can be paused, skipped, sped
//     up, or left from any passage. Play and Pause are one button that changes
//     its label, and every button is icon-only on a phone, to keep the bar short.
//   - The card holds the settings and hand-off options, read once at the top.
// reader-tools.js finds every control inside the [data-reader-tools] wrapper,
// which has no box of its own so the dock's pinning spans the whole article.
interface Props {
	articleId: string;
	lessonNumber: string;
	title: string;
	publicUrl: string;
	sourceUrl: string;
	/** Where "Exit reader mode" goes: the full lesson, as a path on this site. */
	exitHref: string;
	filename: string;
}

const { articleId, lessonNumber, title, publicUrl, sourceUrl, exitHref, filename } = Astro.props;
const id = lessonNumber.replace('.', '-');
---

<div
	class="reader-tools-root"
	data-reader-tools
	data-article-id={articleId}
	data-title={title}
	data-source-url={sourceUrl}
	data-filename={filename}
>
	<div class="reader-dock" role="region" aria-label="Listening controls">
		<div class="reader-dock__controls" role="group" aria-label="Read aloud controls">
			<button type="button" data-speech-back disabled title="Back to the start of this paragraph, or to the one before it">
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 5h2.4v14H6zM19 5.5v13L9.6 12z" /></svg>
				<span class="reader-dock__label">Back</span>
			</button>
			<button type="button" class="reader-dock__primary" data-speech-play>
				<svg data-speech-icon-play viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12-7.5z" /></svg>
				<svg data-speech-icon-pause viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M6.5 5h4v14h-4zM13.5 5h4v14h-4z" /></svg>
				<span class="reader-dock__label" data-speech-play-label>Play</span>
			</button>
			<button type="button" data-speech-forward disabled title="Forward to the next paragraph">
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.6 5H18v14h-2.4zM5 5.5v13L14.4 12z" /></svg>
				<span class="reader-dock__label">Forward</span>
			</button>
			<button type="button" data-speech-stop disabled>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 6.5h11v11h-11z" /></svg>
				<span class="reader-dock__label">Stop</span>
			</button>
			<button type="button" class="reader-dock__speed" data-speech-speed title="Reading speed: press to change">
				<span data-speech-speed-label aria-hidden="true">1×</span>
				<span class="reader-sr-only" data-speech-speed-name>Reading speed 1×. Press to change.</span>
			</button>
		</div>
		<div class="reader-dock__progress">
			<label class="reader-sr-only" for={`reader-progress-${id}`}>Listening progress</label>
			<progress id={`reader-progress-${id}`} data-speech-progress max="1" value="0"></progress>
			<span data-speech-progress-text>Preparing lesson text…</span>
		</div>
		<a class="reader-dock__exit" href={exitHref}>
			<span aria-hidden="true">✕</span><span class="reader-dock__exit-word"> Exit</span><span class="reader-dock__exit-more"> reader mode</span>
		</a>
		<p class="reader-dock__status" data-speech-status role="status" aria-live="polite">Preparing read-aloud controls…</p>
	</div>

	<section class="reader-tools" aria-labelledby={`reader-tools-title-${id}`}>
		<div class="reader-tools__intro">
			<div>
				<p class="reader-tools__eyebrow">Listening desk</p>
				<h2 id={`reader-tools-title-${id}`}>Read this lesson aloud</h2>
			</div>
			<p>This listening version turns labelled diagrams and tables into spoken explanations, reads code comments, and clarifies common abbreviations and symbols. The full lesson keeps the original code and visuals. The bar above stays on screen while you scroll, so you can pause, skip, change the speed, stop, or leave reader mode from any passage.</p>
		</div>

		<div class="reader-tools__settings">
			<label>
				<span>Voice</span>
				<select data-speech-voice aria-label="Read-aloud voice">
					<option value="">Browser default</option>
				</select>
			</label>
			<label>
				<span>Speed <output data-speech-rate-value>1.00×</output></span>
				<input data-speech-rate type="range" min="0.75" max="2" step="0.05" value="1" aria-label="Read-aloud speed" />
			</label>
			<label class="reader-tools__code-option">
				<input data-speech-code type="checkbox" />
				<span>Include raw code in the listening text</span>
			</label>
		</div>
		<p class="reader-tools__hint">A new voice takes effect on the next passage; a new speed applies at once. The highlighted passage marks what is being spoken. The bar above also skips back and forward a paragraph and steps the speed.</p>

		<div class="reader-tools__handoff">
			<h3>Take it to another reader</h3>
			<div class="reader-tools__handoff-grid">
				<div>
					<h4>Chrome Reading mode</h4>
					<p>On desktop Chrome, right-click this page, choose <strong>Open in reading mode</strong>, then press Play. Chrome also offers its own voices and speed control.</p>
					<a href="https://support.google.com/chrome/answer/14218344?hl=en" target="_blank" rel="noopener noreferrer">Google’s Reading mode guide <span aria-hidden="true">↗</span></a>
				</div>
				<div>
					<h4>ElevenReader</h4>
					<p>Choose <strong>Paste a link</strong> in ElevenReader and use the public listening link below. The published page already contains the adapted listening text. You can also paste that text or upload the downloaded TXT file.</p>
					<a href="https://elevenreader.io/" target="_blank" rel="noopener noreferrer">Open ElevenReader <span aria-hidden="true">↗</span></a>
					<a href="https://help.elevenlabs.io/hc/en-us/articles/26197616307985-How-do-I-add-content-to-ElevenReader" target="_blank" rel="noopener noreferrer">Import instructions <span aria-hidden="true">↗</span></a>
				</div>
			</div>
			<label class="reader-tools__link-label" for={`reader-link-${id}`}>Public listening link</label>
			<div class="reader-tools__link-row">
				<input id={`reader-link-${id}`} data-reader-link type="url" value={publicUrl} readonly />
				<button type="button" data-reader-copy-link>Copy link</button>
			</div>
			<div class="reader-tools__export" role="group" aria-label="Export lesson text">
				<button type="button" data-reader-copy-text>Copy text</button>
				<button type="button" data-reader-download>Download TXT</button>
			</div>
			<p class="reader-tools__status" data-reader-action-status role="status" aria-live="polite"></p>
		</div>
		<noscript><p>JavaScript is needed for this page’s playback and export controls. Chrome Reading mode can read the article directly.</p></noscript>
	</section>
</div>

<script>
	import { mountReaderTools } from '../scripts/reader-tools.js';
	mountReaderTools();
</script>
