---
import '../styles/logic-waveform.css';
interface Props { label?: string }
const { label = 'A register captures data on a rising clock edge' } = Astro.props;
---
<figure class="logic-waveform not-content" data-logic-waveform data-reader-skip aria-label={label}>
  <figcaption><strong>{label}</strong><p>Data can change between clock edges. The stored value changes only when the clock goes from 0 to 1.</p></figcaption>
  <div class="logic-waveform__controls" data-wave-controls hidden>
    <label><input type="checkbox" data-wave-input /> Input data is 1</label>
    <button type="button" data-wave-step>Step clock</button>
    <button type="button" data-wave-reset>Reset</button>
    <output data-wave-values>Clock 0 · data 0 · stored 0</output>
  </div>
  <svg viewBox="0 0 480 190" role="img" aria-label="Clock, data input and stored value through four sample times">
    <text x="10" y="35">clock</text><text x="10" y="95">data</text><text x="10" y="155">stored</text>
    <path class="logic-waveform__grid" d="M94 10V174M186 10V174M278 10V174M370 10V174M462 10V174" />
    <path class="logic-waveform__clock" data-wave-clock d="M94 44H186V20H278V44H370V20H462" />
    <path class="logic-waveform__data" data-wave-data d="M94 104H140V80H232V104H462" />
    <path class="logic-waveform__stored" data-wave-stored d="M94 164H186V140H370V164H462" />
    <path class="logic-waveform__edge" data-wave-edges d="M186 10V174M370 10V174" />
    <text x="96" y="186">0</text><text x="188" y="186">1 ↑</text><text x="280" y="186">2 ↓</text><text x="372" y="186">3 ↑</text>
  </svg>
  <p data-wave-status role="status" aria-live="polite">At time 1, the rising edge captures 1. At time 2, data drops to 0 while the stored value stays 1. The next rising edge captures 0.</p>
  <details class="logic-waveform__reference" open><summary>Read the timing example</summary>
    <table><thead><tr><th>Time</th><th>Clock</th><th>Data</th><th>Stored value</th><th>Reason</th></tr></thead><tbody>
      <tr><td>0</td><td>0</td><td>0</td><td>0</td><td>Initial state</td></tr>
      <tr><td>1</td><td>1</td><td>1</td><td>1</td><td>Rising edge captures data</td></tr>
      <tr><td>2</td><td>0</td><td>0</td><td>1</td><td>Falling edge keeps the stored value</td></tr>
      <tr><td>3</td><td>1</td><td>0</td><td>0</td><td>Rising edge captures data</td></tr>
    </tbody></table>
  </details>
</figure>
<script>
  import { mountLogicWaveforms } from '../scripts/logic-waveform';
  mountLogicWaveforms();
</script>
