---
import '../styles/cpu-step.css';
---

<section class="cpu-step not-content" data-cpu-step data-reader-skip aria-label="Change a byte and step through LDA">
	<header><strong>Try a different memory byte</strong><span>One instruction, four actions</span></header>
	<div class="cpu-step__controls">
		<label>RAM at 0x80 <input data-cpu-value type="number" min="0" max="255" step="1" value="10" inputmode="numeric" /></label>
		<button type="button" data-cpu-next>Step</button>
		<button type="button" data-cpu-reset>Reset</button>
	</div>
	<ol class="cpu-step__actions" aria-label="Instruction actions">
		<li data-cpu-action="0" aria-current="step">Fetch opcode</li>
		<li data-cpu-action="1">Decode</li>
		<li data-cpu-action="2">Fetch address</li>
		<li data-cpu-action="3">Read RAM into A</li>
	</ol>
	<svg viewBox="0 0 480 250" role="img" aria-label="Program bytes, memory, and the CPU registers">
		<defs><marker id="cpu-read-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path class="cpu-step__arrow" d="M0 0L10 5L0 10Z"/></marker></defs>
		<path data-cpu-read-path class="cpu-step__read-path" marker-end="url(#cpu-read-arrow)" d="M58 77L58 112L74 130" opacity="0" />
		<g class="cpu-step__bytes">
			<text x="24" y="24">program bytes</text><text x="338" y="24">RAM at 0x80</text>
			<rect data-cpu-source="0" x="24" y="38" width="68" height="38" rx="4"/><rect data-cpu-source="2" x="102" y="38" width="68" height="38" rx="4"/>
			<text x="58" y="63" text-anchor="middle">02</text><text x="136" y="63" text-anchor="middle">80</text>
			<text x="58" y="96" text-anchor="middle">0x02</text><text x="136" y="96" text-anchor="middle">0x03</text>
			<rect data-cpu-source="3" x="338" y="38" width="110" height="38" rx="4"/><text data-cpu-ram x="393" y="63" text-anchor="middle">10</text>
		</g>
		<g class="cpu-step__cpu">
			<rect x="24" y="128" width="424" height="96" rx="6"/>
			<text x="40" y="150">CPU</text>
			<text data-cpu-buffer x="204" y="150">read buffer: —</text>
			<rect data-cpu-register="pc" class="cpu-step__register" x="40" y="160" width="72" height="53" rx="3"/>
				<rect data-cpu-register="a" class="cpu-step__register" x="128" y="160" width="62" height="53" rx="3"/>
				<rect class="cpu-step__register" x="216" y="160" width="62" height="53" rx="3"/>
			<rect data-cpu-register="z" class="cpu-step__register" x="294" y="160" width="45" height="53" rx="3"/>
			<rect data-cpu-register="cycles" class="cpu-step__register" x="358" y="160" width="76" height="53" rx="3"/>
				<text data-reader-register x="48" y="178">PC</text><text data-reader-register x="140" y="178">A</text><text data-reader-register x="228" y="178">X</text><text data-reader-register x="306" y="178">Z</text><text data-reader-register x="370" y="178">cycles</text>
				<text data-reader-value data-cpu-pc x="48" y="203">0x02</text><text data-reader-value data-cpu-a x="140" y="203">0</text><text data-reader-value x="228" y="203">2</text><text data-reader-value data-cpu-z x="306" y="203">0</text><text data-reader-value data-cpu-cycles x="370" y="203">2</text>
		</g>
		<g data-cpu-chip class="cpu-step__chip" opacity="0"><rect width="68" height="38" rx="4"/><text x="34" y="25" text-anchor="middle"></text></g>
		<text data-cpu-decode x="24" y="244">opcode not fetched yet</text>
	</svg>
	<p class="cpu-step__key">Underlined action: what Step does next. Outlined byte: the read source. Filled register: written by this action.</p>
	<p data-cpu-status role="status" aria-live="polite">PC is 0x02. A is 0. Change RAM, then fetch the opcode.</p>
	<noscript><p>The diagram above shows the starting state. The animation before it explains the complete instruction without these controls.</p></noscript>
</section>

<script>
	import { mountCpuStepLabs } from '../scripts/cpu-step.js';
	mountCpuStepLabs();
</script>
