---
import { CHAPTERS, READING_AREAS } from '../data/chapters.mjs';

const areas = READING_AREAS.map((area) => {
	const numbers = CHAPTERS.filter((chapter) => chapter.area === area.id).map((chapter) => chapter.number);
	return { ...area, range: `${numbers[0]}–${numbers.at(-1)}` };
});
---

<aside class="colour-key not-content" aria-label="Book colour key">
	<p><strong>Reading colours</strong> follow the subject area. Chapter numbers and titles identify each chapter.</p>
	<ul>
		{areas.map((area) => (
			<li data-tone={area.tone}>
				<span class="colour-key__dot" aria-hidden="true" />
				<span>{area.label} <small>Ch. {area.range}</small></span>
			</li>
		))}
	</ul>
	<p class="colour-key__feedback">
		Feedback: <span class="colour-key__success">green — correct or successful</span>;{' '}
		<span class="colour-key__warning">amber — caution or unanswered</span>;{' '}
		<span class="colour-key__danger">red — incorrect or invalid</span>.{' '}
		Labels and icons carry the meaning too.
	</p>
</aside>

<style>
	.colour-key {
		margin-block: 1.5rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--surface);
		font-size: 0.85rem;
		line-height: 1.6;
	}
	.colour-key p { margin: 0; color: var(--ink-soft); }
	.colour-key strong { color: var(--ink); }
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.2rem;
		margin: 0.75rem 0;
		padding: 0;
		list-style: none;
	}
	li { display: flex; align-items: center; gap: 0.45rem; color: var(--ink); }
	small { color: var(--ink-soft); white-space: nowrap; }
	.colour-key__dot { width: 0.75rem; height: 0.75rem; flex: none; border-radius: 50%; background: var(--chapter-accent); }
	.colour-key__feedback { font-size: 0.8rem; }
	.colour-key__success { color: color-mix(in srgb, var(--success) 70%, var(--ink)); }
	.colour-key__warning { color: color-mix(in srgb, var(--warning) 70%, var(--ink)); }
	.colour-key__danger { color: color-mix(in srgb, var(--danger) 70%, var(--ink)); }
</style>
