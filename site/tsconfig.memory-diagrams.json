{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/lib/hex-field.ts",
    "src/lib/register-file.ts",
    "src/lib/modrm.ts",
    "src/lib/address-translation.ts",
    "src/lib/stack-frame.ts",
    "src/lib/storage-lifetimes.ts",
    "src/scripts/register-file.ts",
    "src/scripts/modrm-decoder.ts",
    "src/scripts/paging-segmentation.ts",
    "src/scripts/windows-address-map.ts",
    "src/scripts/stack-frame.ts",
    "src/scripts/diagram-player.ts",
    "scripts/check-memory-diagram-models.ts",
    "scripts/check-memory-diagrams-browser.ts"
  ]
}
