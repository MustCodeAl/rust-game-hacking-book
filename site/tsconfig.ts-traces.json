{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/lib/traces-types.ts",
    "src/lib/traces-kit.ts",
    "src/scripts/original-traces.ts",
    "src/scripts/handoff-traces.ts",
    "src/scripts/scene-traces.ts",
    "src/scripts/assembly-traces.ts",
    "src/scripts/rust-idiom-traces.ts",
    "src/scripts/code-trace.ts",
    "src/scripts/cpu-step.ts",
    "src/scripts/behavior-tree-model.ts",
    "scripts/check-assembly-traces.ts",
    "scripts/check-handoff-traces.ts",
    "scripts/check-rust-idiom-traces.ts",
    "scripts/check-behavior-tree-model.ts",
    "scripts/check-scene-explorers.ts"
  ]
}
