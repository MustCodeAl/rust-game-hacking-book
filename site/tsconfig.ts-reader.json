{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/scripts/bubble-records.ts",
    "src/scripts/account.ts",
    "src/scripts/margin-notes.ts",
    "src/scripts/notes.ts",
    "src/scripts/resume-reading.ts",
    "src/scripts/reader-tools.ts",
    "src/scripts/reading-audio.ts",
    "scripts/check-account.ts",
    "scripts/check-reading-audio.ts"
  ]
}
